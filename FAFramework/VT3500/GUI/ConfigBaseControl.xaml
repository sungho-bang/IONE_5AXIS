<UserControl x:Class="FAFramework.VT3500.GUI.ConfigBaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FAFramework.VT3500.GUI"
             xmlns:equipment="clr-namespace:FAFramework.Equipment"
             xmlns:gui="clr-namespace:FAFramework.VT3500.GUI"
             xmlns:gui.standard="clr-namespace:FAFramework.GUI.Standard"
             xmlns:manualControls="clr-namespace:FAFramework.VT3500.GUI" 
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
                mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <Control.Resources>
        <ResourceDictionary>
            <converter:PermissionToVisibilityConverter x:Key="permissionToVisibilityConverter" />
            <converter:BoolInverseConverter x:Key="BoolInverseConverter" />
            <gui:VisiblePartsExistToBoolConverter x:Key="VisiblePartsExistToBoolConverter" />
        </ResourceDictionary>
    </Control.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Visibility="{Binding Source={x:Static equipment:MainEquipment.Instance}, Path=EquipmentManagerInstance.VT3500.CurrentUser.Permission, Converter={StaticResource permissionToVisibilityConverter}, ConverterParameter='OPERATOR'}" Grid.ColumnSpan="3" Margin="0,0,0,781" Grid.RowSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.8" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <!--<TextBlock Text="Read Only" Foreground="Red" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />-->
        </Grid>
        <TabControl Grid.Row="1">
            <TabItem Header="{DynamicResource ResourceKey=Config.Job}">
                <gui:JobSettingControl
                                    EquipmentInstance="{Binding Path=EquipmentManagerInstance.VT3500, Source={x:Static equipment:MainEquipment.Instance}}"
                                    JobManagerInstance="{Binding Path=EquipmentManagerInstance.VT3500.JobManagerInstance, Source={x:Static equipment:MainEquipment.Instance}}" />
            </TabItem>
            <TabItem Header="{DynamicResource RetryAndTime}">
                <TabControl>
                    <TabItem Header="Unit">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ListBox Name="listBoxSubUnits" Tag="{Binding Path=EquipmentManagerInstance.VT3500, Source={x:Static equipment:MainEquipment.Instance}}">
                                <ListBox.Resources>
                                    <ResourceDictionary>
                                        <Style TargetType="ListBoxItem">
                                            <Style.Triggers>
                                                <DataTrigger Value="False">
                                                    <DataTrigger.Binding>
                                                        <Binding Path="Tag.PartList" RelativeSource="{RelativeSource Self}">
                                                            <Binding.Converter>
                                                                <gui:VisiblePartsExistToBoolConverter />
                                                            </Binding.Converter>
                                                        </Binding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ResourceDictionary>
                                </ListBox.Resources>
                                <ListBoxItem Content="Front Loading Unit" Tag="{Binding Tag.FrontLoadingUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                                <ListBoxItem Content="Rear Loading Unit" Tag="{Binding Tag.RearLoadingUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                                <ListBoxItem Content="1st Press Unit" Tag="{Binding Tag.FirstPressUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                                <ListBoxItem Content="2nd Press Unit" Tag="{Binding Tag.SecondPressUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                                <ListBoxItem Content="Option Press Unit" Tag="{Binding Tag.OptionPressUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                                <ListBoxItem Content="3rd Press Unit" Tag="{Binding Tag.ThirdPressUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                                <ListBoxItem Content="4th Press Unit" Tag="{Binding Tag.FourthPressUnit, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                            </ListBox>
                            <UniformGrid Columns="1" Grid.Column="1">
                                <gui.standard:SubUnitRetryTimeSettingControl SubUnit="{Binding SelectedItem.Tag, ElementName=listBoxSubUnits}"/>
                            </UniformGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Module">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ListBox Name="listBoxModules" Tag="{Binding Path=EquipmentManagerInstance.VT3500, Source={x:Static equipment:MainEquipment.Instance}}">
                                <ListBox.Resources>
                                    <ResourceDictionary>
                                        <Style TargetType="ListBoxItem">
                                            <Style.Triggers>
                                                <DataTrigger Value="False">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding>
                                                            <MultiBinding.Converter>
                                                                <gui:AllZeroToBoolConverter />
                                                            </MultiBinding.Converter>
                                                            <Binding Path="Tag.RetryInfoList.Values.Count" RelativeSource="{RelativeSource Self}" />
                                                            <Binding Path="Tag.TimeList.Values.Count" RelativeSource="{RelativeSource Self}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ResourceDictionary>
                                </ListBox.Resources>
                                <ListBoxItem Content="Front Module" Tag="{Binding Tag.FrontModule, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                                <ListBoxItem Content="Rear Module" Tag="{Binding Tag.RearModule, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                                <ListBoxItem Content="First Press Module" Tag="{Binding Tag.FirstPressModule, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                                <ListBoxItem Content="Second Press Module" Tag="{Binding Tag.SecondPressModule, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                                <ListBoxItem Content="Option Press Module" Tag="{Binding Tag.OptionPressModule, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                                <ListBoxItem Content="Third Press Module" Tag="{Binding Tag.ThirdPressModule, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                                <ListBoxItem Content="Fourth Press Module" Tag="{Binding Tag.FourthPressModule, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBox}}" />
                            </ListBox>
                            <UniformGrid Columns="1" Grid.Column="1">
                                <GroupBox Header="Retry">
                                    <gui.standard:ModuleRetrySettingControl Module="{Binding SelectedItem.Tag, ElementName=listBoxModules}" />
                                </GroupBox>
                                <GroupBox Header="Time">
                                    <gui.standard:ModuleTimeSettingControl Module="{Binding SelectedItem.Tag, ElementName=listBoxModules}" />
                                </GroupBox>
                            </UniformGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="{DynamicResource Config.MotorHeader}">
                <TabControl>
                    <TabItem Header="성형 프레스 모터">
                        <gui.standard:MotorConfigControl Part="{Binding Path=EquipmentManagerInstance.VT3500.FrontModule.FirstPressServo, Source={x:Static equipment:MainEquipment.Instance}}" Loaded="MotorConfigControl_Loaded" />
                    </TabItem>
                    <TabItem Header="피넛클 프레스 모터">
                        <gui.standard:MotorConfigControl Part="{Binding Path=EquipmentManagerInstance.VT3500.FrontModule.SecondPressServo, Source={x:Static equipment:MainEquipment.Instance}}" />
                    </TabItem>
                    <TabItem Header="옵션 프레스 모터">
                        <gui.standard:MotorConfigControl Part="{Binding Path=EquipmentManagerInstance.VT3500.FrontModule.OptionPressServo, Source={x:Static equipment:MainEquipment.Instance}}" />
                    </TabItem>
                    <TabItem Header="톰슨 프레스 모터">
                        <gui.standard:MotorConfigControl Part="{Binding Path=EquipmentManagerInstance.VT3500.FrontModule.ThirdPressServo, Source={x:Static equipment:MainEquipment.Instance}}" />
                    </TabItem>
                    <TabItem Header="실링 프레스 모터">
                        <gui.standard:MotorConfigControl Part="{Binding Path=EquipmentManagerInstance.VT3500.RearModule.FourthPressServo, Source={x:Static equipment:MainEquipment.Instance}}" />
                    </TabItem>
                    <TabItem Header="옵션 모터">
                        <gui.standard:MotorConfigControl Part="{Binding Path=EquipmentManagerInstance.VT3500.FrontModule.OptionServo, Source={x:Static equipment:MainEquipment.Instance}}" />
                    </TabItem>
                    <TabItem Header="원단 잔재 회수 모터">
                        <gui.standard:MotorConfigControl Part="{Binding Path=EquipmentManagerInstance.VT3500.FrontModule.TapeCoverServo, Source={x:Static equipment:MainEquipment.Instance}}" />
                    </TabItem>
                    <TabItem Header="그리퍼 모터">
                        <gui.standard:MotorConfigControl Part="{Binding Path=EquipmentManagerInstance.VT3500.FrontModule.TapeLoadingServo, Source={x:Static equipment:MainEquipment.Instance}}" />
                    </TabItem>
                    <TabItem Header="이젝터 상하 모터">
                        <gui.standard:MotorConfigControl Part="{Binding Path=EquipmentManagerInstance.VT3500.FrontModule.BandPickServo, Source={x:Static equipment:MainEquipment.Instance}}" />
                    </TabItem>
                    <TabItem Header="이젝터 좌우 모터">
                        <gui.standard:MotorConfigControl Part="{Binding Path=EquipmentManagerInstance.VT3500.FrontModule.BandTransferServo, Source={x:Static equipment:MainEquipment.Instance}}" />
                    </TabItem>
                    <TabItem Header="포장지 피딩 모터">
                        <gui.standard:MotorConfigControl Part="{Binding Path=EquipmentManagerInstance.VT3500.RearModule.BandRollerServo, Source={x:Static equipment:MainEquipment.Instance}}" />
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="{DynamicResource ResourceKey=Config.AlarmDefineHeader}">
                <gui.standard:AlarmDefineControl />
            </TabItem>
            <TabItem Header="{DynamicResource ResourceKey=Config.SystemHeader}">
                <gui.standard:SystemSettingControl >
                </gui.standard:SystemSettingControl>
            </TabItem>
            <TabItem Header="{DynamicResource ResourceKey=Config.SignalTowerHeader}">
                <gui.standard:SignalTowerControl
                        StateConfig="{Binding Path=EquipmentManagerInstance.VT3500.ModuleStateSignal.EquipmentStateConfigs, Source={x:Static equipment:MainEquipment.Instance}}" />
            </TabItem>

        </TabControl>
        <Button Grid.Row="2" Content="{DynamicResource Save}" Margin="-4,2,8,2"
                Command="{Binding SaveCommand}"
                IsEnabled="{Binding ReadOnly, Converter={StaticResource BoolInverseConverter}}" Grid.ColumnSpan="3" Click="Button_Click"/>
    </Grid>
</UserControl>
