<UserControl x:Class="FAFramework.VT3500.GUI.AlarmMainStatusControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             xmlns:equipment="clr-namespace:FAFramework.Equipment"
             xmlns:utility="clr-namespace:FAFramework.Utility"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="600"
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             Width="891" Height="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source= "/FAFramework;component/ResourceDictionary/ManualControlResource.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:IsEqualMultiValueConverter x:Key="isEqualMultiValueConverter" />
            <Style TargetType="Border" x:Key="ModuleArea">
                <Setter Property="Padding" Value="10" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="BorderThickness" Value="8" />
                <Setter Property="CornerRadius" Value="5" />
                <Style.Triggers>
                    <Trigger Property="Tag">
                        <Trigger.Value>
                            <system:Boolean>False</system:Boolean>
                        </Trigger.Value>
                        <Setter Property="BorderBrush" Value="Red" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.4" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Image" x:Key="AlarmStatus">
                <Setter Property="Visibility" Value="Hidden" />
                <Style.Triggers>
                    <Trigger Property="Tag">
                        <Trigger.Value>
                            <system:Boolean>True</system:Boolean>
                        </Trigger.Value>
                        <Setter Property="Visibility" Value="Visible" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.4" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AlarmImage" TargetType="Image" BasedOn="{StaticResource AlarmStatus}">
                <Setter Property="Source" Value="/FAFramework;component/Images/Alarm.png"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Canvas>
        <Grid Background="White">
            <Image Margin="0,0,0,0"  Stretch="Uniform" Source="/FAFramework;component/Images/MainTopView.png" Opacity="0.7" />
            <Canvas>
                <Border Width="105" Height="98" Canvas.Left="20" Canvas.Top="135">
                    <Image Style="{StaticResource AlarmImage}">
                        <Image.Tag>
                            <MultiBinding Converter="{StaticResource isEqualMultiValueConverter}">
                                <Binding Path="EquipmentInstance.AlarmRaisingStatusManager.CurrentAlarmInfo.AlarmEventArgs.Message" />
                                <Binding Path="EquipmentInstance.VirtualModule.Name" />
                            </MultiBinding>
                        </Image.Tag>
                    </Image>
                </Border>
            </Canvas>
        </Grid>
    </Canvas>
</UserControl>
