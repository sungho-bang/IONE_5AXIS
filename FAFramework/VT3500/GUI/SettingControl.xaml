<UserControl x:Class="FAFramework.VT3500.GUI.SettingControl"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1024"
             Width="1024" Height="600"
             DataContext="{Binding RelativeSource={RelativeSource self}}"
             xmlns:equipment="clr-namespace:FAFramework.Equipment"
             xmlns:utility="clr-namespace:FAFramework.Utility"
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             xmlns:control="clr-namespace:FAFramework.VT3500.GUI.ManualControl">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source= "/FAFramework;component/ResourceDictionary/ManualControlResource.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Lime.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:MultiValueConverter x:Key="multiValueConverter" />
            <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Style TargetType="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Border Style="{StaticResource borderBaseStyle}" Margin="2" HorizontalAlignment="Stretch">
                                <ContentControl Content="{Binding}" Tag="{Binding Path=Tag, RelativeSource={RelativeSource Mode=TemplatedParent}}" ContentTemplate="{StaticResource rightPositionOnOffSensorTemplate}" />
                            </Border>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer>
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="600"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <!--<UniformGrid Grid.Column="0" Grid.Row="0" Background="White" Margin="5">
                <Border Margin="1">
                    <TextBlock Text="빠른 인버터 속도 설정"  FontSize="45" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" />
                </Border>
            </UniformGrid>
            <UniformGrid Grid.Column="1" Grid.Row="0" Background="Gold" Margin="5">
                <Border Margin="1">
                    <TextBox Text="{Binding EquipmentInstance.FrontModule.Inverter_WriteSpeed_Fast}"  FontSize="45" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="269" Height="89" Margin="10,0,10,0" />
                </Border>
            </UniformGrid>-->
            
            <UniformGrid Grid.Column="0" Grid.Row="0" Background="White" Margin="5">
                <DockPanel>
                    <Border VerticalAlignment="Center">
                        <TextBlock Text="인버터모터 속도" FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" TextAlignment="Center" Width="300" />
                    </Border>
                    <Border Margin="1" Background="Gold">
                        <TextBox Text="{Binding EquipmentInstance.FrontModule.Inverter_WriteSpeed_Slow}"  FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="200" Height="89"/>
                    </Border>
                </DockPanel>
            </UniformGrid>
            <!--<UniformGrid Grid.Column="1" Grid.Row="0" Background="Gold" Margin="5">
                <Border Margin="1">
                    <TextBox Text="{Binding EquipmentInstance.FrontModule.Inverter_WriteSpeed_Slow}"  FontSize="45" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="269" Height="89" Margin="10,0,10,0" />
                </Border>
            </UniformGrid>-->

            <UniformGrid Grid.Column="0" Grid.Row="1" Background="White" Margin="5">
                <DockPanel>
                    <Border VerticalAlignment="Center">
                        <TextBlock Text="그리퍼모터 복귀 속도"  FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" TextAlignment="Center" Width="300" />
                    </Border>
                    <Border Margin="1" Background="Gold">
                        <TextBox Text="{Binding EquipmentInstance.FrontModule.TapeLoadingServo.HomePos.DriveSpeed}"  FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="200" Height="89"/>
                    </Border>
                </DockPanel>
            </UniformGrid>

            <UniformGrid Grid.Column="1" Grid.Row="3" Background="White" Margin="5">
                <DockPanel>
                    <Border VerticalAlignment="Center">
                        <TextBlock Text="좌/우 모터 놓는 속도"  FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" TextAlignment="Center" Width="300" />
                    </Border>
                    <Border Margin="1" Background="Gold">
                        <TextBox Text="{Binding  EquipmentInstance.FrontModule.BandTransferServo.HomePos.DriveSpeed}"  FontSize="30" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="200" Height="89"/>
                    </Border>
                </DockPanel>
            </UniformGrid>

            <UniformGrid Grid.Column="0" Grid.Row="3" Background="White" Margin="5">
                <DockPanel>
                    <Border VerticalAlignment="Center">
                        <TextBlock Text="좌/우 모터 집는 속도"  FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" TextAlignment="Center" Width="300" />
                    </Border>
                    <Border Margin="1" Background="Gold">
                        <TextBox Text="{Binding EquipmentInstance.FrontModule.BandTransferServo.TapeLoadingPos.DriveSpeed}"   FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="200" Height="89"/>
                    </Border>
                </DockPanel>
            </UniformGrid>

            <UniformGrid Grid.Column="1" Grid.Row="1" Background="White" Margin="5">
                <DockPanel>
                    <Border VerticalAlignment="Center">
                        <TextBlock Text="그리퍼모터 로딩 속도"  FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" TextAlignment="Center" Width="300" />
                    </Border>
                    <Border Margin="1" Background="Gold">
                        <TextBox Text="{Binding  EquipmentInstance.FrontModule.TapeLoadingServo.TapeLoadingPos.DriveSpeed}"  FontSize="30" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="200" Height="89"/>
                    </Border>
                </DockPanel>
            </UniformGrid>
            <UniformGrid Grid.Column="1" Grid.Row="2" Background="White" Margin="5">
                <DockPanel>
                    <Border VerticalAlignment="Center">
                        <TextBlock Text="상/하 모터 놓는 속도"  FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" TextAlignment="Center" Width="300" />
                    </Border>
                    <Border Margin="1" Background="Gold">
                        <TextBox Text="{Binding  EquipmentInstance.FrontModule.BandPickServo.PlacePos.DriveSpeed}"  FontSize="30" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="200" Height="89"/>
                    </Border>
                </DockPanel>
            </UniformGrid>

            <UniformGrid Grid.Column="0" Grid.Row="2" Background="White" Margin="5">
                <DockPanel>
                    <Border VerticalAlignment="Center">
                        <TextBlock Text="상/하 모터 집는 속도"  FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" TextAlignment="Center" Width="300" />
                    </Border>
                    <Border Margin="1" Background="Gold">
                        <TextBox Text="{Binding EquipmentInstance.FrontModule.BandPickServo.PickPos.DriveSpeed}"   FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="200" Height="89"/>
                    </Border>
                </DockPanel>
            </UniformGrid>
            <UniformGrid Grid.Column="0" Grid.Row="4" Background="White" Grid.ColumnSpan="2" Margin="5">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" >
                    <TextBlock Text="앞속도" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding EquipmentInstance.FrontModule.SpeedScale}" TickFrequency="10" IsSnapToTickEnabled="True" Width="392" Margin="0,15,0,0"/>
                    <TextBlock Text="{Binding EquipmentInstance.FrontModule.SpeedScale, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                    <StackPanel.LayoutTransform>
                        <ScaleTransform ScaleX="2" ScaleY="2" />
                    </StackPanel.LayoutTransform>
                </StackPanel>
            </UniformGrid>


            <UniformGrid Grid.Column="0" Grid.Row="5" Background="White" Margin="5">
                <DockPanel>
                    <Border VerticalAlignment="Center">
                        <TextBlock Text="롤러 서보 빠른 속도"  FontSize="27" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" TextAlignment="Center" Width="300" />
                    </Border>
                    <Border Margin="1" Background="Gold">
                        <TextBox Text="{Binding  EquipmentInstance.RearLoadingUnit.BandRollerServo.TapeLoadingPos.DriveSpeed}"  FontSize="30" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="200" Height="89"/>
                    </Border>
                </DockPanel>
            </UniformGrid>

            <UniformGrid Grid.Column="1" Grid.Row="5" Background="White" Margin="5">
                <DockPanel>
                    <Border VerticalAlignment="Center">
                        <TextBlock Text="롤러 서보 느린 속도"  FontSize="27" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" TextAlignment="Center" Width="300" />
                    </Border>
                    <Border Margin="1" Background="Gold">
                        <TextBox Text="{Binding EquipmentInstance.RearLoadingUnit.BandRollerServo.TapeLoadingSlowPos.DriveSpeed}"   FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="200" Height="89"/>
                    </Border>
                </DockPanel>
            </UniformGrid>

            <UniformGrid Grid.Column="0" Grid.Row="6" Background="White" Margin="5">
                <DockPanel>
                    <!--<Border VerticalAlignment="Center">
                        <TextBlock Text="롤러 서보 아이마크 안함"  FontSize="27" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Left" TextAlignment="Center" Width="300" />
                    </Border>
                    <Border Margin="1" Background="Gold">
                        <TextBox Text="{Binding EquipmentInstance.RearLoadingUnit.BandRollerServo.TapeUnUseImarkPos.DriveSpeed}"   FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="200" Height="89"/>
                    </Border>-->
                </DockPanel>
            </UniformGrid>
            <UniformGrid Grid.Column="0" Grid.Row="7" Background="White" Grid.ColumnSpan="2" Margin="5">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" >
                    <TextBlock Text="뒷속도" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding EquipmentInstance.RearModule.SpeedScale}" TickFrequency="10" IsSnapToTickEnabled="True" Width="392" Margin="0,15,0,0"/>
                    <TextBlock Text="{Binding EquipmentInstance.RearModule.SpeedScale, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                    <StackPanel.LayoutTransform>
                        <ScaleTransform ScaleX="2" ScaleY="2" />
                    </StackPanel.LayoutTransform>
                </StackPanel>
            </UniformGrid>
            <!--<UniformGrid Grid.Column="0" Grid.Row="2" Background="White" Margin="5">
                <Border Margin="1">
                    <TextBlock Text="빠른 박리 속도 설정"  FontSize="45" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" />
                </Border>
            </UniformGrid>
            <UniformGrid Grid.Column="1" Grid.Row="2" Background="Gold" Margin="5">
                <Border Margin="1">
                    <TextBox Text="{Binding EquipmentInstance.FrontModule.HighSpeedVelocity}"  FontSize="45" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="269" Height="89" Margin="10,0,10,0" />
                </Border>
            </UniformGrid>
            <UniformGrid Grid.Column="0" Grid.Row="3" Background="White" Margin="5">
                <Border Margin="1">
                    <TextBlock Text="느린 박리 속도 설정"  FontSize="45" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" />
                </Border>
            </UniformGrid>
            <UniformGrid Grid.Column="1" Grid.Row="3" Background="Gold" Margin="5">
                <Border Margin="1">
                    <TextBox Text="{Binding EquipmentInstance.FrontModule.LowSpeedVelocity}"  FontSize="45" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="269" Height="89" Margin="10,0,10,0" />
                </Border>
            </UniformGrid>
            <!-<UniformGrid Grid.Column="0" Grid.Row="4" Background="White" Margin="10,5,-212,5" Grid.ColumnSpan="2">
                <Border Margin="1">
                    <TextBlock Text="서보 속도 설정"  FontSize="30" FontWeight="Bold" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Width="Auto"/>
                </Border>
            </UniformGrid>
            <UniformGrid Grid.Column="0" Grid.Row="5" Background="White" Grid.ColumnSpan="2" Margin="10,0,-212,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" >
                    <Slider Minimum="0" Maximum="100" Value="{Binding EquipmentInstance.FrontModule.SpeedScale}" TickFrequency="10" IsSnapToTickEnabled="True" Width="392" Margin="0,15,0,0"/>
                    <TextBlock Text="{Binding EquipmentInstance.FrontModule.SpeedScale, StringFormat={}{0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" />
                    <StackPanel.LayoutTransform>
                        <ScaleTransform ScaleX="2" ScaleY="2" />
                    </StackPanel.LayoutTransform>
                </StackPanel>
            </UniformGrid>-->
            <!--<Button Content="저장" Margin="0,80,-211,50" Grid.Row="6" Grid.ColumnSpan="2" Background="LightGray" Foreground="Black" Height="Auto" Grid.RowSpan="2"/>-->
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
