<UserControl x:Class="FAFramework.VT3500.GUI.RearManualControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"              
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
             xmlns:equipment="clr-namespace:FAFramework.Equipment"
             xmlns:utility="clr-namespace:FAFramework.Utility"
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             xmlns:control="clr-namespace:FAFramework.VT3500.GUI.ManualControl"
             mc:Ignorable="d" 
             Height="768" Width="1024"
             DataContext="{Binding RelativeSource={RelativeSource self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source= "/FAFramework;component/ResourceDictionary/ManualControlResource.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:MultiValueConverter x:Key="multiValueConverter" />
            <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Style TargetType="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Border Style="{StaticResource borderBaseStyle}" Margin="2" HorizontalAlignment="Stretch">
                                <ContentControl Content="{Binding}" Tag="{Binding Path=Tag, RelativeSource={RelativeSource Mode=TemplatedParent}}" ContentTemplate="{StaticResource rightPositionOnOffSensorTemplate}" />
                            </Border>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <TextBlock Text="{Binding Subject}" FontSize="36" DockPanel.Dock="Top"/>
        <Grid Width="1023">
            <Grid Grid.Column="0">
                <ListBox Visibility="Collapsed" >
                    <control:FourthPressControl
                        x:Name="FourthPressControl" 
                        FourthUnit="{Binding Path=EquipmentManagerInstance.VT3500.FourthPressUnit, Source={x:Static equipment:MainEquipment.Instance}}"                     
                        EquipmentInstance="{Binding Source={x:Static equipment:MainEquipment.Instance}, Path=EquipmentManagerInstance.VT3500}"
                        ReadOnly="{Binding EquipmentManagerInstance.VT3500.CurrentUser.Permission, Source={x:Static equipment:MainEquipment.Instance},Converter={StaticResource permissionToBoolConverter}, ConverterParameter={StaticResource operatorPermitted}}"/>
                </ListBox>
                <ContentPresenter Name="contentControlSelectedControl">
                    <ContentPresenter.ContentTemplate>
                        <DataTemplate>
                            <Viewbox>
                                <ContentControl Content="{Binding}" />
                            </Viewbox>
                        </DataTemplate>
                    </ContentPresenter.ContentTemplate>
                </ContentPresenter>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84*"/>
                    <ColumnDefinition Width="257*"/>
                </Grid.ColumnDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MainControlView}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MainControlView}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Image Source="/FAFramework;component/Images/VT3500_REAR.png"  Margin="80,52,79,-248" Grid.ColumnSpan="2"/>
                <Canvas Grid.ColumnSpan="2" Margin="0,0,0,-342">
                    <Canvas.Resources>
                        <Style TargetType="Button" x:Name="ManualButton" BasedOn="{StaticResource baseStyle}" >
                            <Setter Property="Opacity" Value="0.5" />
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <EventTrigger.Actions>
                                        <BeginStoryboard x:Name="ButtonAction">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:3" AutoReverse="False"  RepeatBehavior="Forever" FillBehavior="HoldEnd" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <EventTrigger.Actions>
                                        <BeginStoryboard >
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" FillBehavior="HoldEnd">
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Resources>
                    <Canvas Margin="0,464,0,0" >
                        <Grid Grid.Column="0" Grid.Row="1" Height="Auto" ShowGridLines="True" Canvas.Top="-59" Width="1024">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions >
                                <RowDefinition  Height="*" />
                                <RowDefinition  Height="50" />
                                <RowDefinition Height="68" />
                                <RowDefinition Height="68" />
                                <RowDefinition Height="68" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding EquipmentInstance.RearModule.WorkManualLoading.State}" TextAlignment="Center" Background="Gold" Foreground="Black" Margin="0,-31,0,69" HorizontalAlignment="Center" Width="341" FontSize="25" VerticalAlignment="Center" Grid.Column="0"/>
                            <TextBlock Text="{Binding EquipmentInstance.RearModule.WorkManualPress.State}" TextAlignment="Center" Background="Gold" Foreground="Black" Margin="0,-31,0,69" HorizontalAlignment="Center" Width="342" FontSize="25" VerticalAlignment="Center" Grid.Column="1" />
                            <TextBlock Text="{Binding EquipmentInstance.RearModule.WorkRearPullManual.State}" TextAlignment="Center" Background="Gold" Foreground="Black" Margin="0,-31,0,69" HorizontalAlignment="Center" Width="342" FontSize="25" VerticalAlignment="Center" Grid.Column="2" />
                            <UniformGrid Grid.Column="0" Grid.Row="0" Background="White" Margin="5">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" Text="Loading Manual" FontSize="20" Margin="0,0,0,5"/>
                                    <StackPanel.LayoutTransform>
                                        <ScaleTransform ScaleX="2" ScaleY="2" />
                                    </StackPanel.LayoutTransform>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Grid.Column="0" Grid.Row="1" Background="White" Margin="5">
                                <DockPanel>
                                    <TextBlock Text="{Binding EquipmentInstance.RearModule.WorkManualLoading.CurrentIndex}"  Grid.Column="0" Grid.Row="1" Margin="30,0,0,0" HorizontalAlignment="Left" Width="40" FontSize="25" VerticalAlignment="Center" />
                                    <TextBlock Text="/" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                                    <TextBlock Text="{Binding EquipmentInstance.RearModule.WorkManualLoading.Length}" Grid.Column="0" Grid.Row="1" Margin="10,0,0,0" HorizontalAlignment="Right" Width="40" FontSize="25" VerticalAlignment="Center"/>
                                    <DockPanel.LayoutTransform>
                                        <ScaleTransform ScaleX="2" ScaleY="2" />
                                    </DockPanel.LayoutTransform>
                                </DockPanel>
                            </UniformGrid>
                            <UniformGrid Grid.Column="0" Grid.Row="2" Background="White">
                                <Border>
                                    <Button FontSize="30" FontWeight="Bold" VerticalContentAlignment="Center" Style="{StaticResource LEDRoundButton9}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Loading_Start_Button_Click" Width="320" Height="46">
                                        <Button.LayoutTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1.2" />
                                        </Button.LayoutTransform>
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="20" Color="Black" RenderingBias="Quality" ShadowDepth="15"/>
                                        </Button.Effect>
                                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" Text="시  작" FontSize="34" Margin="0" />
                                    </Button>
                                </Border>
                            </UniformGrid>
                            <UniformGrid Grid.Column="0" Grid.Row="3" Background="White">
                                <Border>
                                    <Button FontSize="27" FontWeight="Bold" VerticalContentAlignment="Center" Style="{StaticResource LEDRoundButton9}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Loading_Stop_Button_Click" Width="320" Height="46">
                                        <Button.LayoutTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1.2" />
                                        </Button.LayoutTransform>
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="20" Color="Black" RenderingBias="Quality" ShadowDepth="15"/>
                                        </Button.Effect>
                                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" Text="정  지" FontSize="34" Margin="0" />
                                    </Button>
                                </Border>
                            </UniformGrid>
                            <UniformGrid Grid.Column="0" Grid.Row="4" Background="White">
                                <Border>
                                    <Button FontSize="27" FontWeight="Bold" VerticalContentAlignment="Center" Style="{StaticResource LEDRoundButton9}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Loading_NextStepMove_Button_Click" Width="320" Height="46">
                                        <Button.LayoutTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1.2" />
                                        </Button.LayoutTransform>
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="20" Color="Black" RenderingBias="Quality" ShadowDepth="15"/>
                                        </Button.Effect>
                                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" Text="다  음" FontSize="34" Margin="0" />
                                    </Button>
                                </Border>
                            </UniformGrid>
                            <UniformGrid Grid.Column="1" Grid.Row="0" Background="White" Margin="5">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" Text="Press Manual" FontSize="20" />
                                    <StackPanel.LayoutTransform>
                                        <ScaleTransform ScaleX="2" ScaleY="2" />
                                    </StackPanel.LayoutTransform>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Grid.Column="1" Grid.Row="1" Background="White" Margin="5">
                                <DockPanel>
                                    <TextBlock Text="{Binding EquipmentInstance.RearModule.WorkManualPress.CurrentIndex}"  Grid.Column="0" Grid.Row="1" Margin="30,0,0,0" HorizontalAlignment="Left" Width="40" FontSize="25" VerticalAlignment="Center" />
                                    <TextBlock Text="/" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                                    <TextBlock Text="{Binding EquipmentInstance.RearModule.WorkManualPress.Length}" Grid.Column="0" Grid.Row="1" Margin="10,0,0,0" HorizontalAlignment="Right" Width="40" FontSize="25" VerticalAlignment="Center"/>
                                    <DockPanel.LayoutTransform>
                                        <ScaleTransform ScaleX="2" ScaleY="2" />
                                    </DockPanel.LayoutTransform>
                                </DockPanel>
                            </UniformGrid>
                            <UniformGrid Grid.Column="1" Grid.Row="2" Background="White">
                                <Border>
                                    <Button FontSize="30" FontWeight="Bold" VerticalContentAlignment="Center" Style="{StaticResource LEDRoundButton9}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Press_Start_Button_Click" Width="320" Height="46">
                                        <Button.LayoutTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1.2" />
                                        </Button.LayoutTransform>
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="20" Color="Black" RenderingBias="Quality" ShadowDepth="15"/>
                                        </Button.Effect>
                                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" Text="시  작" FontSize="34" Margin="0" />
                                    </Button>
                                </Border>
                            </UniformGrid>
                            <UniformGrid Grid.Column="1" Grid.Row="3" Background="White">
                                <Border>
                                    <Button FontSize="27" FontWeight="Bold" VerticalContentAlignment="Center" Style="{StaticResource LEDRoundButton9}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Press_Stop_Button_Click" Width="320" Height="46">
                                        <Button.LayoutTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1.2" />
                                        </Button.LayoutTransform>
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="20" Color="Black" RenderingBias="Quality" ShadowDepth="15"/>
                                        </Button.Effect>
                                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" Text="정  지" FontSize="34" Margin="0" />
                                    </Button>
                                </Border>
                            </UniformGrid>
                            <UniformGrid Grid.Column="1" Grid.Row="4" Background="White">
                                <Border>
                                    <Button FontSize="27" FontWeight="Bold" VerticalContentAlignment="Center" Style="{StaticResource LEDRoundButton9}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Press_NextStepMove_Button_Click" Width="320" Height="46">
                                        <Button.LayoutTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1.2" />
                                        </Button.LayoutTransform>
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="20" Color="Black" RenderingBias="Quality" ShadowDepth="15"/>
                                        </Button.Effect>
                                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" Text="다  음" FontSize="34" Margin="0" />
                                    </Button>
                                </Border>
                            </UniformGrid>
                            <UniformGrid Grid.Column="2" Grid.Row="0" Background="White" Margin="5">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" Text="Pull Manual" FontSize="20" />
                                    <StackPanel.LayoutTransform>
                                        <ScaleTransform ScaleX="2" ScaleY="2" />
                                    </StackPanel.LayoutTransform>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Grid.Column="2" Grid.Row="1" Background="White" Margin="5">
                                <DockPanel>
                                    <TextBlock Text="{Binding EquipmentInstance.RearModule.WorkRearPullManual.CurrentIndex}"  Grid.Column="0" Grid.Row="1" Margin="30,0,0,0" HorizontalAlignment="Left" Width="40" FontSize="25" VerticalAlignment="Center" />
                                    <TextBlock Text="/" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
                                    <TextBlock Text="{Binding EquipmentInstance.RearModule.WorkRearPullManual.Length}" Grid.Column="0" Grid.Row="1" Margin="10,0,0,0" HorizontalAlignment="Right" Width="40" FontSize="25" VerticalAlignment="Center"/>
                                    <DockPanel.LayoutTransform>
                                        <ScaleTransform ScaleX="2" ScaleY="2" />
                                    </DockPanel.LayoutTransform>
                                </DockPanel>
                            </UniformGrid>
                            <UniformGrid Grid.Column="2" Grid.Row="2" Background="White">
                                <Border>
                                    <Button FontSize="30" FontWeight="Bold" VerticalContentAlignment="Center" Style="{StaticResource LEDRoundButton9}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Pull_Start_Button_Click" Width="320" Height="46">
                                        <Button.LayoutTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1.2" />
                                        </Button.LayoutTransform>
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="20" Color="Black" RenderingBias="Quality" ShadowDepth="15"/>
                                        </Button.Effect>
                                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" Text="시  작" FontSize="34" Margin="0" />
                                    </Button>
                                </Border>
                            </UniformGrid>
                            <UniformGrid Grid.Column="2" Grid.Row="3" Background="White">
                                <Border>
                                    <Button FontSize="27" FontWeight="Bold" VerticalContentAlignment="Center" Style="{StaticResource LEDRoundButton9}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Pull_Stop_Button_Click" Width="320" Height="46">
                                        <Button.LayoutTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1.2" />
                                        </Button.LayoutTransform>
                                        <Button.Effect>
                                            <DropShadowEffect BlurRadius="20" Color="Black" RenderingBias="Quality" ShadowDepth="15"/>
                                        </Button.Effect>
                                        <TextBlock HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" Text="정  지" FontSize="34" Margin="0" />
                                    </Button>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Canvas>
                    <Canvas Name="buttonsCanvas" Style="{StaticResource actuatorSelectButtonCanvas}">
                        <Button Tag="RearUnit.SealingTopRoller" Height="30" Background="DarkBlue" Width="46" Canvas.Left="737" Canvas.Top="134"   RenderTransformOrigin="0.5,0.5" Margin="0" />
                        <Button Tag="RearUnit.SealingBandCutting" Height="132" Background="DarkBlue" Width="66" Canvas.Left="807" Canvas.Top="134"   RenderTransformOrigin="0.5,0.5" Margin="0" />
                        <Button Tag="RearUnit.SealingTapeLoadingMotor" Height="82" Background="DarkBlue" Width="85" Canvas.Left="799" Canvas.Top="285" d:DataContext="True" RenderTransformOrigin="0.509,0.184" Margin="0" />
                        <Button Tag="RearUnit.BandRollerServo" Height="83" Background="DarkBlue" Width="90" Canvas.Left="693" Canvas.Top="183"   RenderTransformOrigin="0.5,0.5" Margin="0" />
                    </Canvas>
                    <Canvas>
                        <Button Height="208" Background="DarkBlue" Width="124" Canvas.Left="552" Canvas.Top="56" ToolTip="4th Press Control" Command="{Binding ShowControlCommand}" RenderTransformOrigin="0.5,0.5" Margin="0" >
                            <Button.CommandParameter>
                                <MultiBinding Converter="{StaticResource ResourceKey=multiValueConverter}">
                                    <Binding Mode="OneWay" RelativeSource="{RelativeSource Self}" />
                                    <Binding Mode="OneWay" ElementName="FourthPressControl" />
                                </MultiBinding>
                            </Button.CommandParameter>
                        </Button>
                    </Canvas>
                    <Canvas Style="{StaticResource sensorsCanvas}">
                        <StackPanel>
                            <ContentPresenter Content="{Binding RearUnit.IMarkCheckSensor}" Tag="I-Mark X1135" />
                            <ContentPresenter Content="{Binding RearUnit.BlackMarkCheckSensor}" />
                            <ContentPresenter Content="{Binding RearUnit.SealingTapeTensionUpSensor}" />
                            <ContentPresenter Content="{Binding RearUnit.SealingTapeTensionDownSensor}" />
                        </StackPanel>
                    </Canvas>

                    <Grid HorizontalAlignment="Right" Height="560" Canvas.Right="170" Canvas.Top="50" Canvas.Left="10">
                        <ContentControl Content="{Binding Path=Children, ElementName=buttonsCanvas}"
                                ContentTemplate="{StaticResource actuatorOperateButtons}"
                                Tag="{Binding ElementName=buttonsCanvas, Path=Tag}" Margin="0" />
                    </Grid>
                </Canvas>
            </Grid>
            <Grid VerticalAlignment="Top" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                <Canvas Margin="0,0,600,0" FlowDirection="LeftToRight">
                    <Button Name="Closebutton" Content="이 전" HorizontalContentAlignment="Center" VerticalAlignment="Top" Width="90" Height="50" ToolTip="Close" Click="Closebutton_Click" Background="DarkBlue" Foreground="White"
                             Visibility="{Binding GobackButtonHide2, Converter={StaticResource ResourceKey=BoolToVisibilityConverter}}" Canvas.Left="-96" Margin="0" Canvas.Top="5"/>
                </Canvas>
                <Grid.LayoutTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                    </TransformGroup>
                </Grid.LayoutTransform>
            </Grid>
        
        </Grid>
    </DockPanel>
</UserControl>
