<UserControl x:Class="FAFramework.VT3500.GUI.ManualTopViewControl"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1024"
             Width="1024" Height="768"
             DataContext="{Binding RelativeSource={RelativeSource self}}"
             xmlns:equipment="clr-namespace:FAFramework.Equipment"
             xmlns:utility="clr-namespace:FAFramework.Utility"
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             xmlns:control="clr-namespace:FAFramework.VT3500.GUI.ManualControl">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source= "/FAFramework;component/ResourceDictionary/ManualControlResource.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:MultiValueConverter x:Key="multiValueConverter" />
            <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Style TargetType="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Border Style="{StaticResource borderBaseStyle}" Margin="2" HorizontalAlignment="Stretch">
                                <ContentControl Content="{Binding}" Tag="{Binding Path=Tag, RelativeSource={RelativeSource Mode=TemplatedParent}}" ContentTemplate="{StaticResource rightPositionOnOffSensorTemplate}" />
                            </Border>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MainControlView}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MainControlView}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid Grid.Column="0">
                <ListBox Visibility="Collapsed" >
                    <control:ShapeMoldingControl
                        x:Name="ShapeMoldingControl" 
                        SubUnit="{Binding Path=EquipmentManagerInstance.VT3500.FrontLoadingUnit, Source={x:Static equipment:MainEquipment.Instance}}"
                        FirstUnit="{Binding Path=EquipmentManagerInstance.VT3500.FirstPressUnit, Source={x:Static equipment:MainEquipment.Instance}}" 
                        EquipmentInstance="{Binding Source={x:Static equipment:MainEquipment.Instance}, Path=EquipmentManagerInstance.VT3500}"
                        />
                    <control:OptionControl
                        x:Name="OptionControl" 
                        FrontUnit="{Binding Path=EquipmentManagerInstance.VT3500.FrontLoadingUnit, Source={x:Static equipment:MainEquipment.Instance}}"           
                        RearUnit="{Binding Path=EquipmentManagerInstance.VT3500.RearLoadingUnit, Source={x:Static equipment:MainEquipment.Instance}}"     
                        ThirdUnit="{Binding Path=EquipmentManagerInstance.VT3500.ThirdPressUnit, Source={x:Static equipment:MainEquipment.Instance}}"     
                        EquipmentInstance="{Binding Source={x:Static equipment:MainEquipment.Instance}, Path=EquipmentManagerInstance.VT3500}"
                        />
                    <control:FeedingControl
                        x:Name="FeedingControl" 
                        SubUnit="{Binding Path=EquipmentManagerInstance.VT3500.FrontLoadingUnit, Source={x:Static equipment:MainEquipment.Instance}}"                        
                        EquipmentInstance="{Binding Source={x:Static equipment:MainEquipment.Instance}, Path=EquipmentManagerInstance.VT3500}"
                        />
                    <control:PackingControl
                        x:Name="PackingControl" 
                        FrontUnit="{Binding Path=EquipmentManagerInstance.VT3500.FrontLoadingUnit, Source={x:Static equipment:MainEquipment.Instance}}"           
                        RearUnit="{Binding Path=EquipmentManagerInstance.VT3500.RearLoadingUnit, Source={x:Static equipment:MainEquipment.Instance}}"     
                        ThirdUnit="{Binding Path=EquipmentManagerInstance.VT3500.ThirdPressUnit, Source={x:Static equipment:MainEquipment.Instance}}"     
                        EquipmentInstance="{Binding Source={x:Static equipment:MainEquipment.Instance}, Path=EquipmentManagerInstance.VT3500}"
                        />
                    <control:SealingControl
                        x:Name="SealingControl" 
                        SubUnit="{Binding Path=EquipmentManagerInstance.VT3500.RearLoadingUnit, Source={x:Static equipment:MainEquipment.Instance}}"                             
                        FourthUnit="{Binding Path=EquipmentManagerInstance.VT3500.FourthPressUnit, Source={x:Static equipment:MainEquipment.Instance}}" 
                        EquipmentInstance="{Binding Source={x:Static equipment:MainEquipment.Instance}, Path=EquipmentManagerInstance.VT3500}"
                       />
                </ListBox>
                <ContentPresenter Name="contentControlSelectedControl">
                    <ContentPresenter.ContentTemplate>
                        <DataTemplate>
                            <Viewbox>
                                <ContentControl Content="{Binding}" />
                            </Viewbox>
                        </DataTemplate>
                    </ContentPresenter.ContentTemplate>
                </ContentPresenter>
            </Grid>
            <Grid VerticalAlignment="Top" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                <Canvas Margin="105,-2,0,0" FlowDirection="LeftToRight">
                    <Button Name="Closebutton" Content="설비 선택" HorizontalContentAlignment="Center" VerticalAlignment="Top" Width="90" Height="50" ToolTip="Close" Click="Closebutton_Click" Background="DarkBlue" Foreground="White"
                             Visibility="{Binding GobackButtonHide, Converter={StaticResource ResourceKey=BoolToVisibilityConverter}}"/>
                </Canvas>
                <Grid.LayoutTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                    </TransformGroup>
                </Grid.LayoutTransform>
            </Grid>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MainControlView}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MainControlView}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Image Source="/FAFramework;component/Images/MainTopView1.png" />
                <Canvas>
                    <Canvas.Resources>
                        <Style TargetType="Button" x:Name="ManualButton" BasedOn="{StaticResource baseStyle}" >
                            <Setter Property="Opacity" Value="0.5" />
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <EventTrigger.Actions>
                                        <BeginStoryboard x:Name="ButtonAction">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:3" AutoReverse="False"  RepeatBehavior="Forever" FillBehavior="HoldEnd" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <EventTrigger.Actions>
                                        <BeginStoryboard >
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" FillBehavior="HoldEnd">
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Resources>
                    <Button Height="263" Background="AliceBlue" Width="262" Canvas.Left="10" Canvas.Top="257" ToolTip="성형 모듈" Command="{Binding ShowControlCommand}">
                        <Button.CommandParameter>
                            <MultiBinding Converter="{StaticResource ResourceKey=multiValueConverter}">
                                <Binding Mode="OneWay" RelativeSource="{RelativeSource Self}" />
                                <Binding Mode="OneWay" ElementName="ShapeMoldingControl" />
                            </MultiBinding>
                        </Button.CommandParameter>
                    </Button>
                    <Button Height="263" Background="AliceBlue" Width="123" Canvas.Left="444" Canvas.Top="257" ToolTip="피딩 모듈" Command="{Binding ShowControlCommand}">
                        <Button.CommandParameter>
                            <MultiBinding Converter="{StaticResource ResourceKey=multiValueConverter}">
                                <Binding Mode="OneWay" RelativeSource="{RelativeSource Self}" />
                                <Binding Mode="OneWay" ElementName="FeedingControl" />
                            </MultiBinding>
                        </Button.CommandParameter>
                    </Button>
                    <Button Height="263" Background="AliceBlue" Width="162" Canvas.Left="277" Canvas.Top="257" ToolTip="옵션 모듈" Command="{Binding ShowControlCommand}">
                        <Button.CommandParameter>
                            <MultiBinding Converter="{StaticResource ResourceKey=multiValueConverter}">
                                <Binding Mode="OneWay" RelativeSource="{RelativeSource Self}" />
                                <Binding Mode="OneWay" ElementName="OptionControl" />
                            </MultiBinding>
                        </Button.CommandParameter>
                    </Button>
                    <Button Height="263" Background="AliceBlue" Width="201" Canvas.Left="572" Canvas.Top="257" ToolTip="포장 모듈" Command="{Binding ShowControlCommand}">
                        <Button.CommandParameter>
                            <MultiBinding Converter="{StaticResource ResourceKey=multiValueConverter}">
                                <Binding Mode="OneWay" RelativeSource="{RelativeSource Self}" />
                                <Binding Mode="OneWay" ElementName="PackingControl" />
                            </MultiBinding>
                        </Button.CommandParameter>
                    </Button>
                    <Button Height="263" Background="AliceBlue" Width="222" Canvas.Left="778" Canvas.Top="257" ToolTip="실링 모듈" Command="{Binding ShowControlCommand}">
                        <Button.CommandParameter>
                            <MultiBinding Converter="{StaticResource ResourceKey=multiValueConverter}">
                                <Binding Mode="OneWay" RelativeSource="{RelativeSource Self}" />
                                <Binding Mode="OneWay" ElementName="SealingControl" />
                            </MultiBinding>
                        </Button.CommandParameter>
                    </Button>
                </Canvas>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
