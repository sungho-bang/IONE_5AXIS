<UserControl x:Class="FAFramework.VT3500.GUI.ManualControl.FourthPressControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"              
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
             mc:Ignorable="d" 
             Height="768" Width="1024"
             DataContext="{Binding RelativeSource={RelativeSource self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source= "/FAFramework;component/ResourceDictionary/ManualControlResource.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Border Style="{StaticResource borderBaseStyle}" Margin="2" HorizontalAlignment="Stretch">
                                <ContentControl Content="{Binding}" Tag="{Binding Path=Tag, RelativeSource={RelativeSource Mode=TemplatedParent}}" Height="20" ContentTemplate="{StaticResource rightPositionOnOffSensorTemplate}" />
                            </Border>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Press" TargetType="Border" BasedOn="{StaticResource ResourceKey=borderBaseStyle}">
                <Setter Property="Background" Value="Yellow" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="true">
                        <Setter Property="Background" Value="Red" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <TextBlock Text="{Binding Subject}" FontSize="36" DockPanel.Dock="Top"/>
        <Grid>
            <Image Source="/FAFramework;component/Images/Press.png" />
            <Canvas Name="buttonsCanvas" Style="{StaticResource actuatorSelectButtonCanvas}">
				<Button Tag="SubUnit.FourthPressServo" Background="DarkBlue" Width="108" Height="330" Canvas.Left="310" Canvas.Top="54" d:DataContext="True" RenderTransformOrigin="0.5,0.5" >
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="0.092"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>
                </Button>                
            </Canvas>
            <Canvas>
                <Button Name="Upbutton" Content="실린더 상승" HorizontalContentAlignment="Center" VerticalAlignment="Top" Width="90" Height="50" ToolTip="상승" Background="{Binding EquipmentInstance.FourthPressModule.UpButtonColor}"
                        Canvas.Left="580" Canvas.Top="27" PreviewMouseDown="Upbutton_PreviewMouseDown" PreviewMouseUp="Upbutton_PreviewMouseUp" PreviewTouchDown="Upbutton_PreviewTouchDown" PreviewTouchUp="Upbutton_PreviewTouchUp" >
                    <Button.LayoutTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                    </Button.LayoutTransform>
                </Button>
                <Button x:Name="Upbutton_Copy1" Content="상단히터 ON" HorizontalContentAlignment="Center" VerticalAlignment="Top" Width="90" Height="50" ToolTip="켜기" Background="{Binding EquipmentInstance.FourthPressModule.FourthTopHeater}"
                    Canvas.Left="16" Canvas.Top="389" Click="Upbutton_Copy1_Click_1" Margin="0" >
                    <Button.LayoutTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                    </Button.LayoutTransform>
                </Button>
                <Button x:Name="Upbutton_Copy2" Content="상단히터 OFF" HorizontalContentAlignment="Center" VerticalAlignment="Top" Width="90" Height="50" ToolTip="끄기" Background="{Binding EquipmentInstance.FourthPressModule.FourthTopHeater1}"
                    Canvas.Left="577" Canvas.Top="389" Click="Upbutton_Copy2_Click" Margin="0" >
                    <Button.LayoutTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                    </Button.LayoutTransform>
                </Button>
                <Button Name="Downbutton" Content="실린더 하강" HorizontalContentAlignment="Center" VerticalAlignment="Top" Width="90" Height="50" ToolTip="Close" Background="{Binding EquipmentInstance.FourthPressModule.DownButtonColor}"
                        Canvas.Left="580" Canvas.Top="110" PreviewMouseDown="Downbutton_PreviewMouseDown" PreviewMouseUp="Downbutton_PreviewMouseUp" PreviewTouchDown="Downbutton_PreviewTouchDown" PreviewTouchUp="Downbutton_PreviewTouchUp">
                    <Button.LayoutTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                    </Button.LayoutTransform>
                </Button>
                <Border Style="{StaticResource ResourceKey=Press}" Tag="{Binding Path=FourthUnit.MotorRun.IsOn}" Width="40" Height="350" Canvas.Left="340" Canvas.Top="235" FlowDirection="LeftToRight" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform X="{Binding Path=EquipmentInstance.FourthPressModule.PressForce}"/>
                            <RotateTransform Angle="90"/>
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
                <Border BorderBrush="Black" BorderThickness="10" Height="130" HorizontalAlignment="Left" Margin="50,190,0,0" Name="border1" VerticalAlignment="Top" Width="Auto" CornerRadius="10" Background="White">
                    <Grid ShowGridLines="True">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="모터전원" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" />
                        <TextBlock Grid.Column="2" Grid.Row="0" Text="열림출력" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" />
                        <TextBlock Grid.Column="3" Grid.Row="0" Text="닫힘출력" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" />
                        <!--<TextBlock Grid.Column="4" Grid.Row="0" Text="프레스출력" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" />-->

                        <Label Grid.Column="1" Grid.Row="1" IsEnabled="{Binding FourthUnit.MotorRun.IsOn}" Foreground="Black"  VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="37,0,37,1" Width="26" />
                        <Label Grid.Column="2" Grid.Row="1" IsEnabled="{Binding FourthUnit.Opening.IsOn}" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Label Grid.Column="3" Grid.Row="1" IsEnabled="{Binding FourthUnit.Closing.IsOn}" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <!--<Label Grid.Column="4" Grid.Row="1" IsEnabled="{Binding FourthUnit.Accelerate.IsOn}" Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center" />-->

                        <TextBlock Grid.Column="1" Grid.Row="2" Text="모터확인" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" />
                        <TextBlock Grid.Column="2" Grid.Row="2" Text="열림확인" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" />
                        <TextBlock Grid.Column="3" Grid.Row="2" Text="닫힘확인" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" />
                        <TextBlock Grid.Column="4" Grid.Row="2" Text="상사점확인" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" />

                        <Label Grid.Column="1" Grid.Row="3"  Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding FourthUnit.MotorRunCheck.IsOn}"/>
                        <Label Grid.Column="2" Grid.Row="3"  Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding FourthUnit.OpenCheck.IsOn}"/>
                        <Label Grid.Column="3" Grid.Row="3"  Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding FourthUnit.CloseCheck.IsOn}"/>
                        <Label Grid.Column="4" Grid.Row="3"  Foreground="Black" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding FourthUnit.PressCheck.IsOn}"/>
                    </Grid>
                    <Border.LayoutTransform>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                    </Border.LayoutTransform>
                </Border>
            </Canvas>
            <Canvas Style="{StaticResource sensorsCanvas}">
                <StackPanel>
                    <ContentPresenter ToolTip="실링 프레스 하부 히터 파워" Content="{Binding HeaterBottomUnit.FourthPressBottomHeaterPowerOnCheck}" />
                    <ContentPresenter  Content="{Binding EquipmentInstance.FourthPressUnit.PressOilTempCheck}" />
                    <ContentPresenter  Content="{Binding EquipmentInstance.HeaterFourthBottomUnit.SSR80HeatAlarmCheck}" />
                    <ContentPresenter  Content="{Binding EquipmentInstance.HeaterFourthBottomUnit.SSR60HeatAlertCheck}" />
                </StackPanel>
            </Canvas>
            <Grid HorizontalAlignment="Right" Margin="0,100,-120,0">
                <ContentControl Content="{Binding Path=Children, ElementName=buttonsCanvas}"
                                ContentTemplate="{StaticResource actuatorOperateButtons}"
                                Tag="{Binding ElementName=buttonsCanvas, Path=Tag}" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>