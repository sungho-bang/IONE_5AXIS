<UserControl x:Class="FAFramework.VT3500.GUI.ManualControl.SealingControl"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"              
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
             xmlns:equipment="clr-namespace:FAFramework.Equipment"
             xmlns:utility="clr-namespace:FAFramework.Utility"
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             xmlns:control="clr-namespace:FAFramework.VT3500.GUI.ManualControl"
             mc:Ignorable="d" 
             Height="768" Width="1024"
             DataContext="{Binding RelativeSource={RelativeSource self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source= "/FAFramework;component/ResourceDictionary/ManualControlResource.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converter:MultiValueConverter x:Key="multiValueConverter" />
            <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Style TargetType="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Border Style="{StaticResource borderBaseStyle}" Margin="2" HorizontalAlignment="Stretch">
                                <ContentControl Content="{Binding}" Tag="{Binding Path=Tag, RelativeSource={RelativeSource Mode=TemplatedParent}}" ContentTemplate="{StaticResource rightPositionOnOffSensorTemplate}" />
                            </Border>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <TextBlock Text="{Binding Subject}" FontSize="36" DockPanel.Dock="Top"/>
        <Grid Width="1023">
            <Grid Grid.Column="0">
                <ListBox Visibility="Collapsed" >
                    <control:FourthPressControl
                        x:Name="FourthPressControl" 
						SubUnit="{Binding Path=EquipmentManagerInstance.VT3500.RearLoadingUnit, Source={x:Static equipment:MainEquipment.Instance}}"                                                
                        FourthUnit="{Binding Path=EquipmentManagerInstance.VT3500.FourthPressUnit, Source={x:Static equipment:MainEquipment.Instance}}"                     
                        HeaterBottomUnit="{Binding Path=EquipmentManagerInstance.VT3500.HeaterFourthBottomUnit, Source={x:Static equipment:MainEquipment.Instance}}" 
                        EquipmentInstance="{Binding Source={x:Static equipment:MainEquipment.Instance}, Path=EquipmentManagerInstance.VT3500}"
                       />
                </ListBox>
                <ContentPresenter Name="contentControlSelectedControl">
                    <ContentPresenter.ContentTemplate>
                        <DataTemplate>
                            <Viewbox>
                                <ContentControl Content="{Binding}" />
                            </Viewbox>
                        </DataTemplate>
                    </ContentPresenter.ContentTemplate>
                </ContentPresenter>
            </Grid>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MainControlView}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MainControlView}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Image Source="/FAFramework;component/Images/SealingControl.png" />
                <Canvas>
                    <Canvas.Resources>
                        <Style TargetType="Button" x:Name="ManualButton" BasedOn="{StaticResource baseStyle}" >
                            <Setter Property="Opacity" Value="0.5" />
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <EventTrigger.Actions>
                                        <BeginStoryboard x:Name="ButtonAction">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:3" AutoReverse="False"  RepeatBehavior="Forever" FillBehavior="HoldEnd" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <EventTrigger.Actions>
                                        <BeginStoryboard >
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" FillBehavior="HoldEnd">
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger.Actions>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Resources>
                    <Canvas Name="buttonsCanvas" Style="{StaticResource actuatorSelectButtonCanvas}">
                        <Button Tag="SubUnit.SealingTapeLoadingMotor" Background="DarkBlue" Width="102" Height="114" Canvas.Left="633" Canvas.Top="393" d:DataContext="True" RenderTransformOrigin="0.5,0.5" >
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.999"/>
                                    <SkewTransform AngleX="1.915" AngleY="-3.023"/>
                                    <RotateTransform Angle="2.342"/>
                                    <TranslateTransform X="1.68" Y="-10.377"/>
                                </TransformGroup>
                            </Button.RenderTransform>
                        </Button>
                        <Button Tag="SubUnit.BandRollerServo" Background="DarkBlue" Width="209" Height="16" Canvas.Left="675" Canvas.Top="327" d:DataContext="True" RenderTransformOrigin="0.5,0.5" >
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleY="1.824" ScaleX="0.508"/>
                                    <SkewTransform AngleY="-15.161" AngleX="16.193"/>
                                    <RotateTransform Angle="15.08"/>
                                    <TranslateTransform X="-193.859" Y="-27.778"/>
                                </TransformGroup>
                            </Button.RenderTransform>
                        </Button>
                        <Button Tag="SubUnit.SealingTopRoller" Background="DarkBlue" Width="62" Height="68" Canvas.Left="572" Canvas.Top="233" d:DataContext="True" RenderTransformOrigin="0.5,0.5" >
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.869" ScaleY="0.978"/>
                                    <SkewTransform AngleX="22.788" AngleY="-22.869"/>
                                    <RotateTransform Angle="22.699"/>
                                    <TranslateTransform X="-8.558" Y="-14.877"/>
                                </TransformGroup>
                            </Button.RenderTransform>
                        </Button>
                        <Button Tag="SubUnit.SealingBandCutting" Width="63" Background="DarkBlue" Height="83" Canvas.Left="665" Canvas.Top="239" d:DataContext="True" >
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1.01" ScaleY="0.948"/>
                                    <SkewTransform AngleX="12.334" AngleY="-11.666"/>
                                    <RotateTransform Angle="12.5"/>
                                    <TranslateTransform X="-1.558" Y="6.206"/>
                                </TransformGroup>
                            </Button.RenderTransform>
                        </Button>
                    </Canvas>
                    <Canvas>
                        <Button Height="247" Background="DarkBlue" Width="171" Canvas.Left="331" Canvas.Top="155" ToolTip="실링 프레스" Command="{Binding ShowControlCommand}" RenderTransformOrigin="0.5,0.5" Margin="0">
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.963" ScaleY="0.995"/>
                                    <SkewTransform AngleX="-11.543" AngleY="11.805"/>
                                    <RotateTransform Angle="-12.494"/>
                                    <TranslateTransform X="-47.054" Y="-11.827"/>
                                </TransformGroup>
                            </Button.RenderTransform>
                            <Button.CommandParameter>
                                <MultiBinding Converter="{StaticResource ResourceKey=multiValueConverter}">
                                    <Binding Mode="OneWay" RelativeSource="{RelativeSource Self}" />
                                    <Binding Mode="OneWay" ElementName="FourthPressControl" />
                                </MultiBinding>
                            </Button.CommandParameter>
                        </Button>
                    </Canvas>
                    <Canvas Style="{StaticResource sensorsCanvas}">
                        <StackPanel>
                            <!--<ContentPresenter Content="{Binding SubUnit.InSensor}" />
                    <ContentPresenter Content="{Binding SubUnit.OutSensor}" />-->
                        </StackPanel>
                    </Canvas>
                    <Grid HorizontalAlignment="Right" Height="560" Canvas.Right="170" Canvas.Top="150" Canvas.Left="744">
                        <ContentControl Content="{Binding Path=Children, ElementName=buttonsCanvas}"
                                ContentTemplate="{StaticResource actuatorOperateButtons}"
                                Tag="{Binding ElementName=buttonsCanvas, Path=Tag}" />
                    </Grid>
                </Canvas>
                <Canvas Style="{StaticResource sensorsCanvas}">
                    <StackPanel>
                        <ContentPresenter Content="{Binding SubUnit.SealingTapeTensionUpSensor}" />
                        <ContentPresenter Content="{Binding SubUnit.SealingTapeTensionDownSensor}" />
                    </StackPanel>
                </Canvas>
            </Grid>
            <Grid VerticalAlignment="Top" HorizontalAlignment="Right" FlowDirection="RightToLeft">
                <Canvas Margin="0,0,600,0" FlowDirection="LeftToRight">
                    <Button Name="Closebutton" Content="이 전" HorizontalContentAlignment="Center" VerticalAlignment="Top" Width="90" Height="50" ToolTip="Close" Click="Closebutton_Click" Background="DarkBlue" Foreground="White"
                             Visibility="{Binding GobackButtonHide3, Converter={StaticResource ResourceKey=BoolToVisibilityConverter}}" Canvas.Left="-93" Margin="-10,0,0,0" Canvas.Top="29"/>
                </Canvas>
                <Grid.LayoutTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                    </TransformGroup>
                </Grid.LayoutTransform>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>