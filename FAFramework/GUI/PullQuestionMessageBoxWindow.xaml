<Window x:Class="FAFramework.GUI.PullQuestionMessageBoxWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      DataContext="{Binding RelativeSource={RelativeSource self}}"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:utility="clr-namespace:FAFramework.Utility"
        xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
        Title="MessageWindow" MinHeight="300" MinWidth="640" MaxWidth="1280" MaxHeight="768" MouseLeftButtonDown="Window_MouseLeftButtonDown" WindowStyle="None" SizeToContent="WidthAndHeight" ResizeMode="NoResize" Loaded="Window_Loaded" Closing="Window_Closing" WindowStartupLocation="CenterOwner" Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <converter:BoolToVisibilityConverter x:Key="boolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderThickness="4" Margin="0" Padding="2" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <StackPanel.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFA0BBE7" Offset="0" />
                        <GradientStop Color="#FF255CEF" Offset="1" />
                    </LinearGradientBrush>
                </StackPanel.Background>
                <TextBlock Text="{Binding Path=RaisedTime}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <TextBlock Width ="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Path=Caption}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            </StackPanel>
            <Grid Grid.Row="1">
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock x:Name="textBlockMessage" Text="{Binding Path=Message}" TextWrapping="Wrap" TextAlignment="Left" Margin="0" VerticalAlignment="Center" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" />
                </ScrollViewer>
            </Grid>
            <UniformGrid Grid.Row="2" Rows="1">
                <Button Content="{DynamicResource ResourceKey=ContinueSequence}" Command="{Binding Path=ContinueSequenceCommand}" HorizontalAlignment="Stretch" Margin="2" Name="buttonOK" VerticalAlignment="Stretch" FontFamily="Tahoma" FontWeight="Bold" FontSize="18" Height="80" />
                <Button Content="{DynamicResource ResourceKey=Cancel}" Command="{Binding Path=CancelCommand}"  FontFamily="Tahoma" FontSize="18" FontWeight="Bold" HorizontalAlignment="Stretch" Margin="2" VerticalAlignment="Stretch" Height="80" />
            </UniformGrid>
        </Grid>
        <Border.BorderBrush>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="SlateBlue" Offset="0" />
                <GradientStop Color="CornflowerBlue" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
    </Border>
</Window>