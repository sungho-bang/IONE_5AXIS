<UserControl x:Class="FAFramework.GUI.Standard.MotorConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Margin="8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =======================
             헤더 / 축 정보 표시
             ======================= -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Motor Configuration"
                       FontSize="18"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding Part.AxisNo, StringFormat='  (Axis {0})'}"
                       FontSize="16"
                       Margin="10,0,0,0"/>
        </StackPanel>

        <!-- =======================
             Position 목록(일반 포지션)
             ======================= -->
        <GroupBox Header="Positions" Grid.Row="1" Margin="0,0,0,10">
            <Grid>

                <DataGrid ItemsSource="{Binding Positions}"
                          SelectedItem="{Binding SelectedPosition}"
                          AutoGenerateColumns="False"
                          IsReadOnly="{Binding ReadOnly}"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          Margin="0,5">

                    <DataGrid.Columns>

                        <!-- Position Name -->
                        <DataGridTextColumn Header="Name"
                                            Binding="{Binding Name}"
                                            Width="150"
                                            IsReadOnly="True"/>

                        <!-- Position Value -->
                        <DataGridTemplateColumn Header="Position" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}"
                                             GotFocus="TextBox_GotFocus"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             IsReadOnly="{Binding DataContext.ReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             HorizontalContentAlignment="Right"
                                             Padding="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- DriveSpeed -->
                        <DataGridTemplateColumn Header="Speed" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DriveSpeed, UpdateSourceTrigger=PropertyChanged}"
                                             GotFocus="TextBox_GotFocus"
                                             PreviewKeyDown="TextBox_PreviewKeyDown"
                                             IsReadOnly="{Binding DataContext.ReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             HorizontalContentAlignment="Right"
                                             Padding="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>
        </GroupBox>

        <!-- =======================
             Torque Limit Parameters
             ======================= -->
        <GroupBox Header="Torque Limit Params" Grid.Row="2">
            <Grid Margin="0,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ItemsControl ItemsSource="{Binding Positions2}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <StackPanel Orientation="Horizontal" Margin="0,2">

                                <!-- Torque Name -->
                                <TextBlock Text="{Binding Name}"
                                           Width="180" VerticalAlignment="Center"/>

                                <!-- Torque Position -->
                                <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}"
                                         Name="txtTorquePosition"
                                         GotFocus="TextBox_GotFocus"
                                         PreviewKeyDown="TextBox_PreviewKeyDown"
                                         Width="120"
                                         HorizontalContentAlignment="Right"
                                         Padding="2"/>

                                <!-- Torque Drive Speed -->
                                <TextBox Text="{Binding DriveSpeed, UpdateSourceTrigger=PropertyChanged}"
                                         Name="txtTorqueDriveSpeed"
                                         GotFocus="TextBox_GotFocus"
                                         PreviewKeyDown="TextBox_PreviewKeyDown"
                                         Width="120"
                                         Margin="10,0,0,0"
                                         HorizontalContentAlignment="Right"
                                         Padding="2"/>

                            </StackPanel>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </GroupBox>

    </Grid>

</UserControl>
