<UserControl x:Class="FAFramework.GUI.Standard.IOListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             DataContext="{Binding RelativeSource={RelativeSource self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <LinearGradientBrush x:Key="headerBackground" EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFA0BBE7" Offset="0" />
                <GradientStop Color="#FF255CEF" Offset="1" />
            </LinearGradientBrush>
            <converter:BoolInverseConverter x:Key="BoolInverseConverter" />
            <GridView x:Key="ioListGridView" x:Shared="False">
                <GridView.Columns>
                    <GridViewColumn Header="{DynamicResource ResourceKey=Name}" DisplayMemberBinding="{Binding Path=Name}" />
                    <GridViewColumn Header="{DynamicResource ResourceKey=Value}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Path=Value}">
                                    <CheckBox.LayoutTransform>
                                        <ScaleTransform ScaleX="2" ScaleY="2" />
                                    </CheckBox.LayoutTransform>
                                </CheckBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{DynamicResource ResourceKey=Description}" DisplayMemberBinding="{Binding Path=Description}" />
                </GridView.Columns>
            </GridView>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ContentControl Content="{Binding Path=Part}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding GridOrientation}" Value="Horizontal">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0">
                                                <Label DockPanel.Dock="Top" Content="{DynamicResource ResourceKey=IOListPage.InputIO}" Background="{StaticResource ResourceKey=headerBackground}" MinHeight="40" VerticalContentAlignment="Center" />
                                                <ListView DockPanel.Dock="Top" ItemsSource="{Binding Path=InputIO}" View="{StaticResource ResourceKey=ioListGridView}"
                                                          ItemContainerStyle="{StaticResource defaultListViewItemStyle}"
                                                          Tag="{Binding ReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                            </DockPanel>
                                            <GridSplitter Grid.Row="1" ResizeDirection="Rows" Height="5" HorizontalAlignment="Stretch" ShowsPreview="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" />
                                            <DockPanel Grid.Row="2">
                                                <Label DockPanel.Dock="Top" Content="{DynamicResource ResourceKey=IOListPage.OutputIO}" Background="{StaticResource ResourceKey=headerBackground}" MinHeight="40" VerticalContentAlignment="Center" />
                                                <ListView DockPanel.Dock="Top" ItemsSource="{Binding Path=OutputIO}" View="{StaticResource ResourceKey=ioListGridView}"
                                                          ItemContainerStyle="{StaticResource defaultListViewItemStyle}"
                                                          Tag="{Binding ReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding GridOrientation}" Value="Vertical">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <DockPanel Grid.Column="0">
                                                <Label DockPanel.Dock="Top" Content="{DynamicResource ResourceKey=IOListPage.InputIO}" Background="{StaticResource ResourceKey=headerBackground}" MinHeight="40" VerticalContentAlignment="Center" />
                                                <ListView DockPanel.Dock="Top" ItemsSource="{Binding Path=InputIO}" View="{StaticResource ResourceKey=ioListGridView}"
                                                          ItemContainerStyle="{StaticResource defaultListViewItemStyle}"
                                                          Tag="{Binding ReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                            </DockPanel>
                                            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="5" ShowsPreview="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" />
                                            <DockPanel Grid.Column="2">
                                                <Label DockPanel.Dock="Top" Content="{DynamicResource ResourceKey=IOListPage.OutputIO}" Background="{StaticResource ResourceKey=headerBackground}" MinHeight="40" VerticalContentAlignment="Center" />
                                                <ListView DockPanel.Dock="Top" ItemsSource="{Binding Path=OutputIO}" View="{StaticResource ResourceKey=ioListGridView}"
                                                          ItemContainerStyle="{StaticResource defaultListViewItemStyle}"
                                                          Tag="{Binding ReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
        <Button Grid.Row="1" Content="{DynamicResource ResourceKey=IOListPage.SwapRowsAndColumns}" MinHeight="50" Click="Button_Click" />
    </Grid>
</UserControl>
