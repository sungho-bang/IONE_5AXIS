<UserControl x:Class="FAFramework.GUI.Standard.SystemSettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             xmlns:equipment="clr-namespace:FAFramework.Equipment"
             xmlns:utility="clr-namespace:FAFramework.Utility"
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             DataContext="{Binding RelativeSource={RelativeSource self}}">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type utility:BooleanPropertyValue}">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Path=Name}" Grid.Column="0" />
                <TextBlock Text=" : " Grid.Column="1" />
                <CheckBox  IsChecked="{Binding Path=Value}" Grid.Column="2"/>
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type utility:PropertyValue}">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Path=Name}" Grid.Column="0" />
                <TextBlock Text=" : " Grid.Column="1" />
                <TextBox Grid.Column="2" MinWidth="100" Text="{Binding Path=Value, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding}" Style="{StaticResource baseTextBoxStyle}" GotFocus="TextBox_GotFocus" />
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type utility:ReadOnlyPropertyValue}">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Path=Name}" Grid.Column="0" />
                <TextBlock Text=" : " Grid.Column="1" />
                <TextBlock Text="{Binding Path=Value}" Grid.Column="2" />
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type utility:EnumPropertyValue}">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Path=Name}" Grid.Column="0" />
                <TextBlock Text=" : " Grid.Column="1" />
                <ComboBox ItemsSource="{Binding EnumNames}" Text="{Binding Path=Value}" Grid.Column="2"/>
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type utility:PropertyContainer}" ItemsSource="{Binding Path=Value}">
            <TreeViewItem Header="{Binding Path=Name}" Margin="2" />
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type utility:ListPropertyValue}">
            <TreeViewItem Header="{Binding Path=Name}" Margin="2">
                <ListView Margin="0" ItemsSource="{Binding Value}" View="{Binding View}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </TreeViewItem>
        </HierarchicalDataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.IsEnabled>
            <Binding Path="ReadOnly">
                <Binding.Converter>
                    <converter:BoolInverseConverter />
                </Binding.Converter>
            </Binding>
        </Grid.IsEnabled>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <CheckBox Content="Use Virtual Keyboard" IsChecked="{Binding Path=UseVirtualKeyboard, Source={x:Static equipment:MainEquipment.Instance}}" />
            <GroupBox Header="LOG 파일 자동삭제 기간 설정" Margin="0,5,0,5" Padding="5">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Bottom" Content="LOG 기간 저장" Click="SaveLogRetentionButton_Click" Margin="0,5,0,0" Height="35" />
                    <Grid DockPanel.Dock="Top" Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="대상 로그/파일" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Text="보관일" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="적용 경로" FontWeight="Bold" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Path=LogRetentionItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Path=DisplayName}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Path=Days, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             MinWidth="60"
                                             Tag="{Binding}"
                                             Style="{StaticResource baseTextBoxStyle}"
                                             GotFocus="TextBox_GotFocus" />
                                    <TextBlock Grid.Column="2" Text="{Binding Path=TargetPath}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </GroupBox>
            <TreeView Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="treeView1" VerticalAlignment="Stretch" Width="Auto" ItemsSource="{Binding Path=ExtractedConfig}" />
            <ContentControl Content="{Binding Path=AdditionalControl}" />
        </StackPanel>
        </ScrollViewer>
    </Grid>    
</UserControl>
