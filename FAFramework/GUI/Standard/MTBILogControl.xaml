<UserControl x:Class="FAFramework.GUI.Standard.MTBILogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FAFramework.GUI.Standard"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             xmlns:utility="clr-namespace:FAFramework.Utility"
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             DataContext="{Binding RelativeSource={RelativeSource self}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <local:LogToTimeCollection x:Key="LogToTimeCollection" />
            <local:LogToMTBICollection x:Key="LogToMTBICollection" />
            <local:MTBIInfoToPieCollection x:Key="MTBIInfoToPieCollection" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="250" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="grid1" VerticalAlignment="Stretch" Width="Auto">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <GroupBox Header="{DynamicResource ResourceKey=BeginDate}" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="groupBox1" VerticalAlignment="Stretch" Width="Auto">
                <Label Name="beginDate" Style="{StaticResource DateTimeInputTemplate}">
                    <Label.Content>
                        <utility:LogSearchingDateTime Date="{x:Static sys:DateTime.Now}" Hour="0" Minute="0"/>
                    </Label.Content>
                </Label>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="{DynamicResource ResourceKey=EndDate}" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="groupBox2" VerticalAlignment="Stretch" Width="Auto">
                <Label Name="endDate" Style="{StaticResource DateTimeInputTemplate}">
                    <Label.Content>
                        <utility:LogSearchingDateTime Date="{x:Static sys:DateTime.Now}" Hour="24" Minute="00"/>
                    </Label.Content>
                </Label>
            </GroupBox>
            <Button Command="{Binding Path=LogSearcherObject.Search}" Content="{DynamicResource ResourceKey=Search}" Grid.Row="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="buttonSearch" VerticalAlignment="Stretch" Width="Auto">
                <Button.CommandParameter>
                    <MultiBinding>
                        <MultiBinding.Converter>
                            <converter:MultiValueConverter/>
                        </MultiBinding.Converter>
                        <Binding ElementName="beginDate" Path="Content"/>
                        <Binding ElementName="endDate" Path="Content"/>
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>
            <Button Command="{Binding Path=LogSearcherObject.SaveToCSV}"
                    CommandParameter="{Binding ElementName=listViewLogs, Path=ItemsSource, Mode=OneWay}" Content="{DynamicResource ResourceKey=SaveToCSV}" Grid.Row="3" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="buttonSaveToCSV" VerticalAlignment="Stretch" Width="Auto" />
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <lvc:CartesianChart Series="{Binding LogSearcherObject.Result.LogList, Converter={StaticResource LogToTimeCollection}}"  LegendLocation="Right">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title="Date" LabelFormatter="{Binding TimeCollectionXFormatter}" />
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="Time" LabelFormatter="{Binding TimeCollectionYFormatter}" />
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
            <lvc:CartesianChart Grid.Row="1" Series="{Binding LogSearcherObject.Result.LogList, Converter={StaticResource LogToMTBICollection}}"  LegendLocation="Right">
                <lvc:CartesianChart.AxisX>
                    <lvc:Axis Title="Date" LabelFormatter="{Binding TimeCollectionXFormatter}" />
                </lvc:CartesianChart.AxisX>
                <lvc:CartesianChart.AxisY>
                    <lvc:Axis Title="Time" LabelFormatter="{Binding TimeCollectionYFormatter}" Foreground="DodgerBlue" />
                    <lvc:Axis Title="Count" LabelFormatter="{Binding TimeCollectionYFormatter}" Foreground="IndianRed" />
                </lvc:CartesianChart.AxisY>
            </lvc:CartesianChart>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ListView Height="Auto" HorizontalAlignment="Stretch" Margin="0"
                  Name="listViewLogs" VerticalAlignment="Stretch" Width="Auto"
                  ItemsSource="{Binding Path=LogSearcherObject.Result.LogList}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Control.VerticalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="SkyBlue"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource ResourceKey=Date}" DisplayMemberBinding="{Binding Path=Date, StringFormat='yyyy-MM-dd'}" />
                            <GridViewColumn Header="MTBI" DisplayMemberBinding="{Binding MTBI, StringFormat={}{0:hh}:{0:mm}:{0:ss}}" />
                            <GridViewColumn Header="AlarmCount" DisplayMemberBinding="{Binding AlarmCount}" />
                            <GridViewColumn Header="Run" DisplayMemberBinding="{Binding RunTime, StringFormat={}{0:hh}:{0:mm}:{0:ss}}" />
                            <GridViewColumn Header="RunDown" DisplayMemberBinding="{Binding RunDownTime, StringFormat={}{0:hh}:{0:mm}:{0:ss}}" />
                            <GridViewColumn Header="Stop" DisplayMemberBinding="{Binding StopTime, StringFormat={}{0:hh}:{0:mm}:{0:ss}}" />
                            <GridViewColumn Header="Alarm" DisplayMemberBinding="{Binding AlarmTime, StringFormat={}{0:hh}:{0:mm}:{0:ss}}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <lvc:PieChart Grid.Column="1"
                    LegendLocation="Bottom" DataClick="PieChart_OnDataClick"
                    Hoverable="False" DataTooltip="{x:Null}"
                    Series="{Binding ElementName=listViewLogs, Path=SelectedItem, Converter={StaticResource MTBIInfoToPieCollection}}">
                    
                </lvc:PieChart>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
