<UserControl x:Class="FAFramework.GUI.Standard.DoorStatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FAFramework.GUI.Standard"
             mc:Ignorable="d"
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             Name="root">
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <Style x:Key="FlickControl" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=Visibility}" Value="Visible">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.8" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="doorCloseStatus">
                <Grid>
                    <Image Name="doorClosed"
                           FlowDirection="{Binding Path=FlowDirection, RelativeSource={RelativeSource TemplatedParent}}"
                           Visibility="{Binding Path=Closed, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Source" Value="/FAFramework;component/Images/door_closed.png" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DoorOpenDirection, ElementName=root}" Value="FrontSlide">
                                        <Setter Property="Source" Value="/FAFramework;component/Images/slide%20door_closed.png" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <Grid Style="{StaticResource FlickControl}">
                        <Image>
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="/FAFramework;component/Images/door%20open.png" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DoorOpenDirection, ElementName=root}" Value="FrontSlide">
                                            <Setter Property="Source" Value="/FAFramework;component/Images/slide%20door%20open.png" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ElementName=doorClosed, Path=Visibility}" Value="Visible">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="doorLockStatus">
                <Image Source="/FAFramework;component/Images/unlock.png"
                       Style="{StaticResource FlickControl}" />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Viewbox>
        <Grid>
            <Grid.RenderTransform>
                <RotateTransform Angle="{Binding Angle, ElementName=root}" />
            </Grid.RenderTransform>
            <Grid.RenderTransformOrigin>
                <Point X="0.5" Y="0.5" />
            </Grid.RenderTransformOrigin>
            <ContentPresenter Content="{Binding DoorPart, ElementName=root}"
                              ContentTemplate="{StaticResource doorCloseStatus}"
                              FlowDirection="{Binding FlowDirection, ElementName=doorLock}"
                              Width="64" />
            <ContentPresenter Name="doorLock"
                              Content="{Binding DoorPart, ElementName=root}"
                              ContentTemplate="{StaticResource doorLockStatus}"
                              Width="24" Margin="0, 24, 0, 0">
                <ContentPresenter.Style>
                    <Style TargetType="ContentPresenter">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Content.Locked, RelativeSource={RelativeSource Self}}" Value="Lock">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Content.CloseOnly, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DoorOpenDirection, ElementName=root}" Value="Right">
                                <Setter Property="FlowDirection" Value="RightToLeft" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentPresenter.Style>
            </ContentPresenter>
        </Grid>
    </Viewbox>
</UserControl>
