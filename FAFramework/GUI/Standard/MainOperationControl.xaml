<UserControl x:Class="FAFramework.GUI.Standard.MainOperationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" DataContext="{Binding RelativeSource={RelativeSource Self}}" Loaded="UserControl_Loaded"  d:DesignWidth="300" FontSize="20" Margin="0,-20,0,0">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style TargetType="{x:Type Button}" >
                        <!--BasedOn="{StaticResource LEDRoundButton9}">-->
                        <Style.Triggers>
                            <Trigger Property="AllowDrop" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:0.4" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=FontSize, Mode=OneWay}" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <UniformGrid Rows="0" Columns="1" >
        <Button Name="StartButton" Content="{DynamicResource ResourceKey=Operation.Start}"  Click="Button_Click" Focusable="False" Style="{StaticResource StartButton}" Margin="0,-5">
        </Button>

        <Button Name="StopButton"  Content="{DynamicResource ResourceKey=Operation.Stop}"  Click="Button_Click_1" Focusable="False"  Style="{StaticResource StopButton}" Margin="0,-5">
        </Button>

        <Button Name="JamClearButton" Content="{DynamicResource ResourceKey=Operation.JamClear}" Click="Button_Click_3"  Focusable="False" Style="{StaticResource AlarmButton}" Margin="0,-5">
        </Button>

        <Button Name="SoundClearButton" Content="{DynamicResource ResourceKey=Operation.SoundClear}" Click="Button_Click_4" Focusable="False"  Style="{StaticResource MuteButton}" Margin="0,-5">
        </Button>

        <Button Name="InitializeButton" Content="{DynamicResource ResourceKey=Operation.Initialize}" Click="Button_Click_2" Focusable="False"  Style="{StaticResource InitialButton}" Margin="0,-5">
        </Button>
    </UniformGrid>
</UserControl>
