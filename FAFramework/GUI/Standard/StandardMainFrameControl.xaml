<UserControl x:Class="FAFramework.GUI.Standard.StandardMainFrameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FAFramework"
             xmlns:equipment="clr-namespace:FAFramework.Equipment"
             xmlns:utility="clr-namespace:FAFramework.Utility"
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             xmlns:manager="clr-namespace:FAFramework.Manager"             
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             Width="Auto" Height="Auto"
             DataContext="{Binding RelativeSource={RelativeSource self}}"
             Name="root"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:StateToVisibilityConverter x:Key="stateToVisibliityConverter"/>
            <converter:StateToBoolConverter x:Key="stateToBoolConverter"/>
            <manager:OpenFailDeviceConverter x:Key="openFailDeviceConverter"/>
            <converter:BoolInverseConverter x:Key="BoolInverseConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=DeviceOpenStatus, Source={x:Static equipment:MainEquipment.Instance}}">
                                <DataTrigger.Value>
                                    <equipment:EDeviceOpenStatus>None</equipment:EDeviceOpenStatus>
                                </DataTrigger.Value>
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Name="textBorder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{StaticResource WireDrawingBrushKey}">
                        <TextBlock Name="textBlock"
                                            Margin="40"
                                            FontSize="48pt"
                                            Foreground="Black">
                                            V E S T E K
                            <TextBlock.TextEffects>
                                <TextEffect x:Name="textEffect" PositionCount="1">
                                    <TextEffect.Transform>
                                        <TranslateTransform x:Name="translateTransform"/>
                                    </TextEffect.Transform>
                                </TextEffect>
                            </TextBlock.TextEffects>
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="TextBlock.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="translateTransform"
                                                Storyboard.TargetProperty="Y"
                                                RepeatBehavior="Forever"
                                                AutoReverse="True"
                                                Duration="00:00:0.25"
                                                From="0"
                                                To="20" />
                                            <Int32AnimationUsingKeyFrames
                                                Storyboard.TargetName="textEffect"
                                                Storyboard.TargetProperty="PositionStart"
                                                RepeatBehavior="Forever"
                                                AutoReverse="True"
                                                Duration="0:0:6.5">
                                                <Int32AnimationUsingKeyFrames.KeyFrames>
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:0"   Value="0"  />
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:0.5" Value="1"  />
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:1"   Value="2"  />
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:1.5" Value="3"  />
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:2"   Value="4"  />
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:2.5" Value="5"  />
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:3"   Value="6"  />
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:3.5" Value="7"  />
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:4"   Value="8"  />
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:4.5" Value="9"  />
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:5"   Value="10" />
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:5.5" Value="11" />
                                                    <DiscreteInt32KeyFrame KeyTime="0:0:6"   Value="12" />
                                                </Int32AnimationUsingKeyFrames.KeyFrames>
                                            </Int32AnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </Border>
                    <Rectangle Name="reflectedTextRectangle"
                         Width="{Binding ElementName=textBorder, Path=ActualWidth}"
                         Height="{Binding ElementName=textBorder, Path=ActualHeight}"
                         HorizontalAlignment="Center" Grid.Row="1">
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="0.5 0" EndPoint="0.5 1">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStop Offset="0.0" Color="#66000000" />
                                    <GradientStop Offset="1.0" Color="#00000000" />
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                        <Rectangle.Fill>
                            <VisualBrush Visual="{Binding ElementName=textBorder}">
                                <VisualBrush.RelativeTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="1" ScaleY="-1" />
                                        <TranslateTransform Y="1" />
                                    </TransformGroup>
                                </VisualBrush.RelativeTransform>
                            </VisualBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <ContentControl ContentTemplate="{StaticResource spinnerTemplate}" Grid.Row="2" HorizontalAlignment="Center" />
                    <TextBlock Grid.Row="3" Text="Doing Device Openning..." Margin="20" HorizontalAlignment="Center" />
                </Grid>
            </Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=DeviceOpenStatus, Source={x:Static equipment:MainEquipment.Instance}}">
                                <DataTrigger.Value>
                                    <equipment:EDeviceOpenStatus>Fail</equipment:EDeviceOpenStatus>
                                </DataTrigger.Value>
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Grid.Row="0" Margin="5" Background="Red">
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Grid.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation BeginTime="0:0:0" Duration="0:0:0.6"
                                                    Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
                                                    From="Red" To="White" AutoReverse="True"
                                                    RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <TextBlock Text="Device Open Fail" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <GroupBox Grid.Row="1" Header="Open Fail Devices" Margin="5">
                    <ListView Grid.Row="1" ItemsSource="{Binding Path=Tag.Items, RelativeSource={RelativeSource Self}}"
                          Tag="{Binding Path=DeviceOpenFailStatus, Source={x:Static equipment:MainEquipment.Instance}, Converter={StaticResource openFailDeviceConverter}}">
                        <ListView.View>
                            <GridView>
                                <GridView.Columns>
                                    <GridViewColumn Header="Device Name" DisplayMemberBinding="{Binding DeviceName}" />
                                    <GridViewColumn Header="Open Fail Message" DisplayMemberBinding="{Binding ExceptionMessage}" />
                                </GridView.Columns>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
                <Button Grid.Row="2" Content="Open Device" MinHeight="80" Margin="5" Command="{Binding ClickOpenDevice}" />
            </Grid>
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=DeviceOpenStatus, Source={x:Static equipment:MainEquipment.Instance}}">
                                <DataTrigger.Value>
                                    <equipment:EDeviceOpenStatus>Success</equipment:EDeviceOpenStatus>
                                </DataTrigger.Value>
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid Visibility="{Binding Path=EquipmentInstance.State, Converter={StaticResource ResourceKey=stateToVisibliityConverter}, ConverterParameter=isnot;EmergencyState, Mode=OneWay}">
                    <Grid.Resources>
                        <ResourceDictionary>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource baseStyle}">
                                <Setter Property="Margin" Value="2" />
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Path=FontSize, Mode=OneWay}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ResourceDictionary>
                    </Grid.Resources>
                    <Grid HorizontalAlignment="Stretch" Margin="0" UseLayoutRounding="False" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Frame Grid.Row="0" Height="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"  Margin="0" Name="frameMainView" NavigationUIVisibility="Hidden" VerticalAlignment="Stretch" Width="Auto">
                            <Frame.Content>
                                <Binding Path="CurrentPage"/>
                            </Frame.Content>
                        </Frame>
                        <ContentControl Grid.Row="1" Margin="0">
                            <Grid Height="Auto" Background="White" HorizontalAlignment="Center" Name="GridBottomMenu" VerticalAlignment="Stretch" Width="Auto" 
                                  IsEnabled="{Binding EquipmentInstance.MaintenanceMode, Converter={StaticResource BoolInverseConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding Path=ClickMenu}" CommandParameter="{Binding Path=PageMain}"  Grid.Column="0" Height="Auto" HorizontalAlignment="Stretch"  Name="buttonMain" VerticalAlignment="Stretch" Width="auto" Focusable="False" 
                                 Style="{StaticResource HomeButton}" BorderBrush="#FFF" >
                                </Button>

                                <Button  Command="{Binding Path=ClickMenu}" CommandParameter="{Binding Path=PageManual}" Grid.Column="2" Height="Auto" HorizontalAlignment="Stretch" Name="buttonManual" VerticalAlignment="Stretch" Width="auto" Focusable="False"  
                                 Style="{StaticResource ManualButton}" BorderBrush="#FFF"  >
                                </Button>

                                <Button  Command="{Binding Path=ClickMenu}" CommandParameter="{Binding Path=PageConfig}" Grid.Column="4" Height="Auto" HorizontalAlignment="Stretch" Name="buttonConfig" VerticalAlignment="Stretch" Width="auto" Focusable="False"  
                                 Style="{StaticResource ConfigButton}" BorderBrush="#FFF"  >
                                </Button>

                                <Button  Command="{Binding Path=ClickMenu}" CommandParameter="{Binding Path=PageLog}" Grid.Column="6" Height="Auto" HorizontalAlignment="Stretch" Name="buttonLog" VerticalAlignment="Stretch" Width="auto" Focusable="False"  
                                 Style="{StaticResource LogButton}" BorderBrush="#FFF"  >
                                </Button>

                                <Button IsEnabled="{Binding Path=EquipmentInstance.State, Converter={StaticResource ResourceKey=stateToBoolConverter}, ConverterParameter=is;StopState, Mode=OneWay}" Grid.Column="8" Height="auto" HorizontalAlignment="Center"  Name="buttonExit" VerticalAlignment="Stretch" Width="auto" Click="buttonExit_Click" Focusable="False"  
                                 Style="{StaticResource ExitButton}" BorderBrush="#FFF"  >
                                </Button>
                            </Grid>
                        </ContentControl>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Grid Background="Black" Visibility="{Binding Path=EquipmentInstance.State, Converter={StaticResource ResourceKey=stateToVisibliityConverter}, ConverterParameter=is;EmergencyState, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>
            <Label FontFamily="Tahoma" FontSize="140" FontWeight="Bold" Foreground="Red" Height="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0" Name="label1" VerticalAlignment="Stretch" VerticalContentAlignment="Center">
                <Viewbox>
                    <TextBlock Text="{DynamicResource ResourceKey=Emergency}" Margin="2" />
                </Viewbox>
            </Label>
            <Button FontFamily="Tahoma" FontSize="48" FontWeight="Bold" Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="buttonReset" VerticalAlignment="Stretch" Width="Auto" Click="buttonReset_Click">
                <Viewbox>
                    <TextBlock Text="{DynamicResource ResourceKey=EmergencyReset}" Margin="5" />
                </Viewbox>
            </Button>
        </Grid>
    </Grid>
</UserControl>