<UserControl x:Class="FAFramework.GUI.Standard.TimeSettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             DataContext="{Binding RelativeSource={RelativeSource self}}"
             xmlns:FALibraryUtility="clr-namespace:FALibrary.Utility;assembly=FALibrary"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <ResourceDictionary>
            <converter:NullToVisibillityConverter x:Key="nullToVisibillityConverter" />
            <Style x:Key="timeSettingListViewStyle" TargetType="{x:Type ListView}" x:Shared="False">
                <Setter Property="View">
                    <Setter.Value>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource ResourceKey=Name}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Path=Name}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource ResourceKey=Time}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Path=TypeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource ResourceKey=TimeUnit}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Source={StaticResource DetailFATimeProvider}}" SelectedItem="{Binding Path=Type, Mode=TwoWay}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource ResourceKey=Description}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Path=Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <TabControl ItemContainerStyle="{StaticResource tabItemStyle}">
        <TabItem Header="{DynamicResource ResourceKey=Config.Part}" Visibility="{Binding Path=SubUnit, Converter={StaticResource ResourceKey=nullToVisibillityConverter}}">
            <ListView ItemsSource="{Binding Path=SubUnit.PartList}"
                      Tag="{Binding ReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <ListView.Resources>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource defaultListViewItemStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Part.TimeList.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridView.Columns>
                            <GridViewColumn Header="{DynamicResource ResourceKey=Name}" DisplayMemberBinding="{Binding Path=Part.Name}" />
                            <GridViewColumn Header="{DynamicResource ResourceKey=TimeList}">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ListView ItemsSource="{Binding Path=Part.TimeList.Values}" Style="{StaticResource ResourceKey=timeSettingListViewStyle}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView.Columns>
                    </GridView>
                </ListView.View>
            </ListView>
        </TabItem>
        <TabItem Header="{DynamicResource ResourceKey=Config.Unit}" Visibility="{Binding Path=Module, Converter={StaticResource ResourceKey=nullToVisibillityConverter}}">
            <ListView ItemsSource="{Binding Path=Module.TimeList.Values}"
                      Style="{StaticResource ResourceKey=timeSettingListViewStyle}"
                      ItemContainerStyle="{StaticResource defaultListViewItemStyle}"
                      Tag="{Binding ReadOnly, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
        </TabItem>
    </TabControl>
</UserControl>
