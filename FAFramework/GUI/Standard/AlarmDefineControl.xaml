<UserControl x:Class="FAFramework.GUI.Standard.AlarmDefineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
             mc:Ignorable="d"
             d:DesignHeight="679" d:DesignWidth="832"
             DataContext="{Binding RelativeSource={RelativeSource self}}">
    <Grid>        
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="grid1" VerticalAlignment="Stretch" Width="Auto">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ListView SelectedItem="{Binding Path=SelectedItem, Mode=OneWayToSource}" ItemsSource="{Binding Path=AlarmList.Values}" Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="listViewAlarmList" SelectionMode="Single" VerticalAlignment="Stretch" Width="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Control.VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{DynamicResource ResourceKey=AlarmNo}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path=AlarmNo}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{DynamicResource ResourceKey=AlarmStatus}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedIndex="{Binding Status}">
                                        <ComboBox.Template>
                                            <ControlTemplate>
                                                <TextBlock Text="{Binding Path=SelectedItem.Text, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                            </ControlTemplate>
                                        </ComboBox.Template>
                                        <ComboBox.Items>
                                            <TextBlock Text="{DynamicResource Alarm}" />
                                            <TextBlock Text="{DynamicResource Warning}" />
                                        </ComboBox.Items>
                                    </ComboBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{DynamicResource ResourceKey=AlarmType}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedIndex="{Binding Type}">
                                        <ComboBox.Template>
                                            <ControlTemplate>
                                                <TextBlock Text="{Binding Path=SelectedItem.Text, RelativeSource={RelativeSource Mode=TemplatedParent}}" />
                                            </ControlTemplate>
                                        </ComboBox.Template>
                                        <ComboBox.Items>
                                            <TextBlock Text="{DynamicResource Machine}" />
                                            <TextBlock Text="{DynamicResource Material}" />
                                            <TextBlock Text="{DynamicResource Human}" />
                                            <TextBlock Text="{DynamicResource Method}" />
                                        </ComboBox.Items>
                                    </ComboBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{DynamicResource ResourceKey=AlarmName}" DisplayMemberBinding="{Binding AlarmName}" />
                        <GridViewColumn Header="{DynamicResource ResourceKey=AlarmSolution}" DisplayMemberBinding="{Binding Solution}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
        <Grid Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="grid3" VerticalAlignment="Stretch" Width="Auto">
            <Grid.IsEnabled>
                <Binding Path="ReadOnly">
                    <Binding.Converter>
                        <converter:BoolInverseConverter />
                    </Binding.Converter>
                </Binding>
            </Grid.IsEnabled>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="grid4" VerticalAlignment="Stretch" Width="Auto">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>
                <Grid Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="grid5" VerticalAlignment="Stretch" Width="Auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100*" />
                        <ColumnDefinition Width="279*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Label Content="{DynamicResource ResourceKey=AlarmStatus}" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="labelStatus" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" />
                    <Label Content="{DynamicResource ResourceKey=AlarmNo}" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="labelCode" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" />
                    <Label Content="{DynamicResource ResourceKey=AlarmName}" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Row="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="labelName" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" />
                    <Label Content="{DynamicResource ResourceKey=AlarmType}" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Row="3" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="labelType" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Width="Auto" />
                    <ComboBox SelectedIndex="{Binding Path=Alarm.Status, Mode=TwoWay}" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Column="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="comboBoxStatus" VerticalAlignment="Stretch" Width="Auto">
                        <TextBlock Text="{DynamicResource Alarm}" />
                        <TextBlock Text="{DynamicResource Warning}" />
                    </ComboBox>
                    <ComboBox SelectedIndex="{Binding Path=Alarm.Type, Mode=TwoWay}" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Column="1" Grid.Row="3" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="comboBoxType" VerticalAlignment="Stretch" Width="Auto">
                        <TextBlock Text="{DynamicResource Machine}" />
                        <TextBlock Text="{DynamicResource Material}" />
                        <TextBlock Text="{DynamicResource Human}" />
                        <TextBlock Text="{DynamicResource Method}" />
                    </ComboBox>
                    <DockPanel Grid.Column="1" Grid.Row="1" >
                        <TextBox DockPanel.Dock="Left" Text="{Binding Path=Alarm.AlarmNo, Mode=TwoWay}"  FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="textBoxCode" VerticalAlignment="Stretch" Width="Auto" />
                        <TextBox DockPanel.Dock="Right" Text="{Binding Path=Alarm.AlarmCodeName, Mode=TwoWay}"  FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="textBoxCodeName" VerticalAlignment="Stretch" Width="Auto" IsReadOnly="True" />
                    </DockPanel>
                    <TextBox Text="{Binding Path=Alarm.AlarmName, Mode=TwoWay}" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Column="1" Grid.Row="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="textBoxName" VerticalAlignment="Stretch" Width="Auto" />
                </Grid>
                <Grid Grid.Row="3" HorizontalAlignment="Stretch" Margin="0" Name="grid6" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Click="buttonSave_Click" Content="{DynamicResource ResourceKey=Save}" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Column="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="buttonSave" VerticalAlignment="Stretch" Width="Auto" />
                    <Button Click="buttonAdd_Click" Content="{DynamicResource ResourceKey=Add}" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="buttonAdd" VerticalAlignment="Stretch" Width="Auto" />
                    <Button Click="buttonDelete_Click" Content="{DynamicResource ResourceKey=Remove}" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Column="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="buttonDelete" VerticalAlignment="Stretch" Width="Auto" />
                </Grid>
                <GroupBox FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Row="1" Header="{DynamicResource ResourceKey=AlarmSolution}" HorizontalAlignment="Stretch" Margin="0" Name="groupBoxSolution" VerticalAlignment="Stretch">
                    <Grid>
                        <TextBox Text="{Binding Path=Alarm.Solution, Mode=TwoWay}"  AcceptsReturn="True" AcceptsTab="True" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" HorizontalAlignment="Stretch" Margin="2" Name="textBoxSolution" VerticalAlignment="Stretch" />
                    </Grid>
                </GroupBox>
                <GroupBox FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Row="2" Header="{DynamicResource ResourceKey=Description}" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="groupBoxDescription" VerticalAlignment="Stretch" Width="Auto">
                    <Grid>
                        <TextBox Text="{Binding Path=Alarm.Description, Mode=TwoWay}" AcceptsReturn="True" AcceptsTab="True" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" HorizontalAlignment="Stretch" Margin="2" Name="textBoxDescription" VerticalAlignment="Stretch" />
                    </Grid>
                </GroupBox>
            </Grid>
            <GroupBox FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Column="1" Header="{DynamicResource ResourceKey=Image}" HorizontalAlignment="Stretch" Margin="0" Name="groupBoxImage" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="60" />
                    </Grid.RowDefinitions>
                    <Image Source="{Binding Path=Alarm.ImagePath}" Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="imageAlarmImage" VerticalAlignment="Stretch" Width="Auto" />
                    <Grid Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="grid2" VerticalAlignment="Stretch" Width="Auto">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Button Click="buttonSetImage_Click" Content="{DynamicResource ResourceKey=SetImage}" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Column="1" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="buttonSetImage" VerticalAlignment="Stretch" Width="Auto" />
                        <Button Click="buttonClearImage_Click" Content="{DynamicResource ResourceKey=RemoveImage}" FontFamily="Tahoma" FontSize="18" FontWeight="Bold" Grid.Column="2" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="buttonClearImage" VerticalAlignment="Stretch" Width="Auto" />
                        <TextBox Text="{Binding Path=Alarm.ImagePath, Mode=TwoWay}" Height="Auto" HorizontalAlignment="Stretch" Margin="2" Name="textBoxImagePath" VerticalAlignment="Stretch" Width="Auto" />
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
