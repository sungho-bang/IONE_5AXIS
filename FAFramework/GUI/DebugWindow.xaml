<Window x:Class="FAFramework.GUI.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:GenericDependencyElement="clr-namespace:FAFramework.Utility"
        DataContext="{Binding RelativeSource={RelativeSource self}}"
        xmlns:gui="clr-namespace:FAFramework.GUI"
        xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
        Title="DebugWindow" Height="300" Width="300" Closing="Window_Closing">
    <Window.Resources>
        <converter:MultiValueConverter x:Key="multiValueConverter" />
        <HierarchicalDataTemplate DataType="{x:Type GenericDependencyElement:ClickAction}">
            <Button Content="{Binding Path=Name}" Tag="{Binding}" Click="Button_Click"/>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type GenericDependencyElement:UpDownAction}">
            <Button Content="{Binding Path=Name}" Tag="{Binding}" PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp"  PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"/>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type GenericDependencyElement:BooleanPropertyValue}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Path=Name}" Grid.Column="0" />
                <TextBlock Text=" : " Grid.Column="1" />
                <CheckBox  IsChecked="{Binding Path=Value}" Grid.Column="2"/>
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type GenericDependencyElement:PropertyValue}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Path=Name}" Grid.Column="0" />
                <TextBlock Text=" : " Grid.Column="1" />
                <TextBox Text="{Binding Path=Value}" Grid.Column="2" AcceptsReturn="True" AcceptsTab="True"/>
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type GenericDependencyElement:ReadOnlyPropertyValue}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Path=Name}" Grid.Column="0" />
                <TextBlock Text=" : " Grid.Column="1" />
                <TextBlock Text="{Binding Path=Value}" Grid.Column="2" />
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type GenericDependencyElement:EnumPropertyValue}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Path=Name}" Grid.Column="0" />
                <TextBlock Text=" : " Grid.Column="1" />
                <ComboBox ItemsSource="{Binding EnumNames}" Text="{Binding Path=Value}" Grid.Column="2"/>
            </Grid>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type GenericDependencyElement:PropertyContainer}" ItemsSource="{Binding Path=Value}">
            <TreeViewItem Header="{Binding Path=Name}" />
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type GenericDependencyElement:ListPropertyValue}">
            <TreeViewItem Header="{Binding Path=Name}">
                <ListView Margin="0" ItemsSource="{Binding Value}" View="{Binding View}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </TreeViewItem>
        </HierarchicalDataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <PasswordBox Name="password" />
            <Button Content="Lock" Grid.Column="1" Command="{Binding ClickLockCommand}">
                <Button.CommandParameter>
                    <MultiBinding Converter="{StaticResource ResourceKey=multiValueConverter}">
                        <Binding Mode="OneWay" ElementName="password" />
                        <Binding Mode="OneWay" ElementName="tabControl" />
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>
            <Button Content="Unlock" Grid.Column="2" Command="{Binding ClickUnlockCommand}">
                <Button.CommandParameter>
                    <MultiBinding Converter="{StaticResource ResourceKey=multiValueConverter}">
                        <Binding Mode="OneWay" ElementName="password" />
                        <Binding Mode="OneWay" ElementName="tabControl" />
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>
        </Grid>
        <TabControl Grid.Row="1" Name="tabControl" Visibility="Collapsed">
            <TabItem Header="Debug Tree">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TreeView Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="treeView1" VerticalAlignment="Stretch" Width="Auto" ItemsSource="{Binding Path=Items}" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="1" BorderThickness="0" SnapsToDevicePixels="False" >
                        <TreeView.Style>
                            <Style TargetType="{x:Type TreeView}">
                                <Style.BasedOn>
                                    <Style TargetType="{x:Type TreeView}">
                                        <Setter Property="Background" Value="{DynamicResource WhiteBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BlackBrush}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="1"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type TreeView}">
                                                    <Border x:Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                                        <ScrollViewer x:Name="TreeViewScrollViewer" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                                            <ItemsPresenter/>
                                                        </ScrollViewer>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
                                                <Setter Property="ItemsPanel">
                                                    <Setter.Value>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel IsItemsHost="True"/>
                                                        </ItemsPanelTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="BorderBrush" Value="{DynamicResource GrayBrush9}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Style.BasedOn>
                            </Style>
                        </TreeView.Style>
                    </TreeView>
                    <Button Name="buttonSaveAll" Grid.Row="1" Content="Save All" Height="50" Click="buttonSaveAll_Click" />
                </Grid>
            </TabItem>
            <TabItem Header="Alarm Regist">
                <gui:AlarmRegistControl />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
