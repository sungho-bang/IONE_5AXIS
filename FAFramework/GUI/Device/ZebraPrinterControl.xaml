<UserControl x:Class="FAFramework.GUI.Device.ZebraPrinterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             DataContext="{Binding RelativeSource={RelativeSource Self}}"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource baseStyle}">
                <Setter Property="Margin" Value="2" />
                <Setter Property="Padding" Value="5" />
                <Setter Property="Height" Value="40" />
            </Style>
            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource baseTextBlockStyle}">
                <Setter Property="Margin" Value="2" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label IsEnabled="{Binding Path=PrinterPart.StatusOnlineError}" Margin="2" Width="25" Height="25" Style="{StaticResource OnOffSensorLabel}" />
                <TextBlock Text="{DynamicResource Device.ZebraPrinter.OnlineError}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label IsEnabled="{Binding Path=PrinterPart.StatusPaperOutError}" Margin="2" Width="25" Height="25" Style="{StaticResource OnOffSensorLabel}" />
                <TextBlock Text="{DynamicResource Device.ZebraPrinter.PaperOut}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label IsEnabled="{Binding Path=PrinterPart.StatusRibbonOut}" Margin="2" Width="25" Height="25" Style="{StaticResource OnOffSensorLabel}" />
                <TextBlock Text="{DynamicResource Device.ZebraPrinter.RibbonOut}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label IsEnabled="{Binding Path=PrinterPart.StatusHeadOpenError}" Margin="2" Width="25" Height="25" Style="{StaticResource OnOffSensorLabel}" />
                <TextBlock Text="{DynamicResource Device.ZebraPrinter.HeadUp}" />
            </StackPanel>
            <UniformGrid Columns="1">
                <Button Content="{DynamicResource Device.ZebraPrinter.CheckStatus}" Command="{Binding Path=CheckStatusCommand}" />
                <Button Content="{DynamicResource Device.ZebraPrinter.PrintEmptyLabel}" Command="{Binding Path=PrintEmptyLabelCommand}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <ComboBox Name="comboBoxLabelFormats" ItemsSource="{Binding TestFormats}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Key}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Content="{DynamicResource Device.ZebraPrinter.PrintTestLabel}" Command="{Binding Path=PrintTestLabelCommand}" CommandParameter="{Binding ElementName=comboBoxLabelFormats, Path=SelectedItem.Value}" Click="Button_Click" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox DockPanel.Dock="Left" Name="textBoxLabelScript" />
                    <Button Grid.Column="1" Content="{DynamicResource Device.ZebraPrinter.PrintFormat}" Command="{Binding Path=PrintLabelFormatCommand}" CommandParameter="{Binding ElementName=textBoxLabelScript, Path=Text, Mode=OneWay}" />
                </Grid>
            </UniformGrid>
        </StackPanel>        
    </Grid>
</UserControl>
