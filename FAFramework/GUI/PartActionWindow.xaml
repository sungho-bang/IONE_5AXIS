<Window x:Class="FAFramework.GUI.PartActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        
        DataContext="{Binding RelativeSource={RelativeSource self}}"
        xmlns:utility="clr-namespace:FAFramework.Utility"
        xmlns:converter="clr-namespace:FAFramework.Utility.Converter"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="PartActionWindow" Height="415" Width="818">    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition MinWidth="200" Width="3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition MinWidth="150" Width="2.5*" />
            </Grid.ColumnDefinitions>
            <GroupBox Header="{DynamicResource ResourceKey=Status}" HorizontalAlignment="Stretch" Margin="0" Name="groupBox3" VerticalAlignment="Stretch">
                <Grid>
                    <TreeView Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="treeView1" VerticalAlignment="Stretch" Width="Auto" ItemsSource="{Binding Path=PartDefine.StatusObjectList}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type utility:BooleanPropertyValue}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Path=Name}" Grid.Column="0" />
                                    <TextBlock Text=" : " Grid.Column="1" />
                                    <CheckBox  IsChecked="{Binding Path=Value}" Grid.Column="2"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type utility:ReadOnlyPropertyValue}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Path=Name}" Grid.Column="0" />
                                    <TextBlock Text=" : " Grid.Column="1" />
                                    <TextBlock Text="{Binding Path=Value}" Grid.Column="2" />
                                </Grid>
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type utility:PropertyContainer}" ItemsSource="{Binding Path=Value}">
                                <TextBlock Text="{Binding Path=Name}"/>
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type utility:ListPropertyValue}">
                                <TreeViewItem Header="{Binding Path=Name}" IsExpanded="True">
                                    <ListView Margin="0" ItemsSource="{Binding Value}">
                                        <ListView.View>
                                            <Binding Path="View" Mode="OneWay">
                                                <Binding.Converter>
                                                    <converter:GridViewColumnRemoveConverter />
                                                </Binding.Converter>
                                                <Binding.ConverterParameter>
                                                    <x:Array Type="{x:Type system:String}">
                                                        <system:String>SimulationMode</system:String>
                                                        <system:String>Index</system:String>
                                                        <system:String>IsInverse</system:String>
                                                        <system:String>CorrectionValue</system:String>
                                                        <system:String>IgnoreInterlock</system:String>
                                                        <system:String>RangeList</system:String>
                                                    </x:Array>
                                                </Binding.ConverterParameter>
                                            </Binding>
                                        </ListView.View>
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                    </ListView>
                                </TreeViewItem>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="TreeViewItem.IsExpanded" Value="True"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </GroupBox>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="5" ShowsPreview="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" />
            <GroupBox Header="{DynamicResource ResourceKey=Actions}" HorizontalAlignment="Stretch" Margin="0" Name="groupBox1" VerticalAlignment="Stretch" Grid.Column="2">
                <Grid>
                    <ListView Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="listViewActions" VerticalAlignment="Stretch" Width="Auto" ItemsSource="{Binding Path=PartDefine.Actions}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource ResourceKey=UseRepeat}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="True" DataContext="{Binding}" Checked="CheckedUseRepeatCheckBox" Unchecked="UncheckedUseRepeatCheckBox" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="{DynamicResource ResourceKey=Action}" Width="120">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Path=Alias}" Click="ClickAction" DataContext="{Binding}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>
            <GridSplitter Grid.Column="3" ResizeDirection="Columns" Width="5" ShowsPreview="True" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" />
            <GroupBox Header="{DynamicResource ResourceKey=Repeat}" HorizontalAlignment="Stretch" Margin="0" Name="groupBox2" VerticalAlignment="Stretch" Grid.Column="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="50" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="1" Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="buttonExecuteRepeatActions" VerticalAlignment="Stretch" Width="Auto" Click="buttonExecuteRepeatActions_Click" DataContext="{Binding PartDefine}">
                        <Button.AllowDrop>
                            <Binding Path="IsStopedRepeatAction" />
                        </Button.AllowDrop>
                        <Button.Style>
                            <Style>
                                <Style.Triggers>
                                    <Trigger Property="Button.AllowDrop" Value="True">
                                        <Setter Property="Button.Content" Value="Start" />
                                    </Trigger>
                                    <Trigger Property="Button.AllowDrop" Value="False">
                                        <Setter Property="Button.Content" Value="Stop" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ListView Height="Auto" HorizontalAlignment="Stretch" Margin="0" Name="listViewRepeatActions" VerticalAlignment="Stretch" Width="Auto" ItemsSource="{Binding Path=PartDefine.RepeatActionList}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource ResourceKey=Action}" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=Alias}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </GroupBox>            
        </Grid>
        <Button Content="Close" Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,2,0,0" Name="buttonClose" VerticalAlignment="Stretch" Click="buttonClose_Click" />
    </Grid>
</Window>
