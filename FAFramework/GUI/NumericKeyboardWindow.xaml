<Window x:Class="FAFramework.GUI.NumericKeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        DataContext="{Binding RelativeSource={RelativeSource self}}"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="NumericKeyboardWindow" ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" WindowStartupLocation="CenterScreen">
    <Border BorderThickness="4" Margin="0" Padding="2" CornerRadius="0">
        <Border.BorderBrush>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="SlateBlue" Offset="0" />
                <GradientStop Color="CornflowerBlue" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <StackPanel>
            <Grid Height="30">
                <Grid.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFA0BBE7" Offset="0" />
                        <GradientStop Color="#FF255CEF" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
            </Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition />
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <GroupBox Header="Range">
                        <GroupBox.Resources>
                            <ResourceDictionary>
                                <Style TargetType="TextBlock">
                                    <Style.Setters>
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style.Setters>
                                </Style>
                            </ResourceDictionary>
                        </GroupBox.Resources>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Min" Grid.Row="0" Grid.Column="0" />
                            <TextBlock Text="Max" Grid.Row="0" Grid.Column="2" />
                            <TextBlock Text="{Binding Path=Min}" Grid.Row="1" Grid.Column="0" />
                            <TextBlock Text="~" Grid.Row="1" Grid.Column="1" />
                            <TextBlock Text="{Binding Path=Max}" Grid.Row="1" Grid.Column="2" />
                        </Grid>
                    </GroupBox>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Path=InputValueString}" Height="Auto" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="2" Padding="2" />
                    <Button Name="buttonClear" Content="Clear" Grid.Column="1" Width="80" Margin="2" Click="buttonClear_Click" />
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.Resources>
                        <ResourceDictionary>
                            <Style TargetType="Button">
                                <Style.Setters>
                                    <Setter Property="Width" Value="80" />
                                    <Setter Property="Height" Value="50" />
                                </Style.Setters>
                            </Style>
                        </ResourceDictionary>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Button Name="buttonZero" Content="0" Grid.Row="3" Grid.Column="0" Margin="2" Click="buttonZero_Click" Tag="0" />
                    <Button Name="buttonDot" Content="." Grid.Row="3" Grid.Column="1" Margin="2" Click="buttonDot_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Setters>
                                    <Setter Property="IsEnabled" Value="False" />
                                </Style.Setters>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=NumType}" Value="{x:Type system:Single}">
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=NumType}" Value="{x:Type system:Double}">
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Name="buttonSign" Content="+/-" Grid.Row="3" Grid.Column="3" Margin="2" Click="buttonSign_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Setters>
                                    <Setter Property="IsEnabled" Value="True" />
                                </Style.Setters>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=NumType}" Value="{x:Type system:UInt16}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=NumType}" Value="{x:Type system:UInt32}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=NumType}" Value="{x:Type system:UInt64}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=NumType}" Value="{x:Type system:Byte}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="1" Grid.Row="2" Grid.Column="0" Margin="2" Tag="1" Click="buttonNumber_Click" />
                    <Button Content="2" Grid.Row="2" Grid.Column="1" Margin="2" Tag="2" Click="buttonNumber_Click" />
                    <Button Content="3" Grid.Row="2" Grid.Column="2" Margin="2" Tag="3" Click="buttonNumber_Click" />
                    <Button Content="4" Grid.Row="1" Grid.Column="0" Margin="2" Tag="4" Click="buttonNumber_Click" />
                    <Button Content="5" Grid.Row="1" Grid.Column="1" Margin="2" Tag="5" Click="buttonNumber_Click" />
                    <Button Content="6" Grid.Row="1" Grid.Column="2" Margin="2" Tag="6" Click="buttonNumber_Click" />
                    <Button Content="7" Grid.Row="0" Grid.Column="0" Margin="2" Tag="7" Click="buttonNumber_Click" />
                    <Button Content="8" Grid.Row="0" Grid.Column="1" Margin="2" Tag="8" Click="buttonNumber_Click" />
                    <Button Content="9" Grid.Row="0" Grid.Column="2" Margin="2" Tag="9" Click="buttonNumber_Click" />
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Name="buttonOK" Content="OK" Grid.Column="0" Margin="2" Click="buttonOK_Click" />
                    <Button Name="buttonCancel" Content="Cancel" Grid.Column="1" Margin="2" IsCancel="True" Click="buttonCancel_Click" />
                </Grid>
            </Grid>
        </StackPanel>        
    </Border>
</Window>
