<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"                    
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:utility="clr-namespace:FAFramework.Utility">
    <Style TargetType="{x:Type Control}" x:Key="baseStyle">
        <Setter Property="FontFamily" Value="Tahoma" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontStretch" Value="Normal" />
    </Style>
    <Style TargetType="{x:Type TextBlock}" x:Key="baseTextBlockStyle">
        <Setter Property="FontFamily" Value="Tahoma" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="FontStretch" Value="Normal" />
    </Style>
    <Style x:Key="baseTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource baseStyle}">
        <Setter Property="utility:VirtualKeyboardAttached.InputBindings">
            <Setter.Value>
                <InputBindingCollection>
                    <MouseBinding MouseAction="LeftClick">
                        <MouseBinding.Command>
                            <RoutedCommand />
                        </MouseBinding.Command>
                    </MouseBinding>
                </InputBindingCollection>
            </Setter.Value>
        </Setter>
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate x:Name="InspectorErrorTemplate">
                    <StackPanel Orientation="Vertical">
                        <Border BorderBrush="Red" BorderThickness="0" CornerRadius="4">
                            <AdornedElementPlaceholder Name="adornerPlaceholder" Margin="0" Width="Auto" Height="Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            </AdornedElementPlaceholder>
                        </Border>
                        <Border BorderThickness="1" BorderBrush="Black" CornerRadius="4" Background="LightYellow">
                            <Label Width="Auto" Height="Auto" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                   Name="labelError"
                                   HorizontalContentAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   FontSize="{Binding ElementName=adornerPlaceholder, Path=AdornedElement.FontSize}"
                                   FontWeight="ExtraBold"
                                   Foreground="Red" Content="{Binding ElementName=adornerPlaceholder, Path=AdornedElement.(Validation.Errors).CurrentItem.ErrorContent}">
                            </Label>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource baseTextBoxStyle}"/>
    <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource baseTextBlockStyle}"/>
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource baseStyle}"/>
    <Style TargetType="{x:Type Label}" BasedOn="{StaticResource baseStyle}"/>    
    <Style TargetType="{x:Type ListView}" BasedOn="{StaticResource baseStyle}"/>
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource baseStyle}"/>
    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource baseStyle}"/>
    <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource baseStyle}"/>
    <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource baseStyle}"/>
    <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource baseStyle}"/>
    <Style TargetType="{x:Type ContentControl}" BasedOn="{StaticResource baseStyle}"/>
    <Style TargetType="{x:Type Frame}" BasedOn="{StaticResource baseStyle}"/>
    <Style TargetType="{x:Type Expander}" BasedOn="{StaticResource baseStyle}"/>
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource baseStyle}"/>
    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource baseStyle}">
        <Setter Property="utility:VirtualKeyboardAttached.PasswordInputBindings">
            <Setter.Value>
                <InputBindingCollection>
                    <MouseBinding MouseAction="LeftClick">
                        <MouseBinding.Command>
                            <RoutedCommand />
                        </MouseBinding.Command>
                    </MouseBinding>
                </InputBindingCollection>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource baseStyle}">
        <Setter Property="Height" Value="45" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="2" />
    </Style>
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Header" Value="{Binding Path=Title}" />
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Label x:Name="label" Content="{Binding}" Margin="2, 0, 2, 0" MinWidth="60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType={x:Type TabItem}},Path=IsSelected}" Value="True">
                            <Setter TargetName="label" Property="Background" Value="Yellow"/>
                            <Setter TargetName="label" Property="BorderBrush" Value="Red"/>
                            <Setter TargetName="label" Property="BorderThickness" Value="5"/>
                            <Setter TargetName="label" Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>