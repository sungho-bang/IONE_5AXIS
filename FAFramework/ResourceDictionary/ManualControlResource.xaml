<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                    xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:servoPart="clr-namespace:FALibrary.Part.MMCPart;assembly=FALibrary"
                    xmlns:memPart="clr-namespace:FALibrary.Part.MemoryBasePart;assembly=FALibrary"
                    xmlns:utility="clr-namespace:FAFramework.Utility"
                    xmlns:converter="clr-namespace:FAFramework.Utility.Converter">
    <converter:CamelCaseConverter x:Key="CamelCaseConverter" />
    <converter:ExtractServoPositionsConverter x:Key="ExtractServoPositionsConverter" />
    <converter:PartSearchConverter x:Key="PartSearchConverter" />
    <converter:IsAssignableConverter x:Key="IsAssignableConverter" />
    <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <Style TargetType="CheckBox" x:Key="ledCheckBox">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Grid Background="Lime">
                                <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Grid Background="Gray">
                                <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>        
    </Style>
    <Style TargetType="DockPanel">
        <Style.Setters>
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style.Setters>
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource ResourceKey=OnOffSensorLabel}">
        <Style.Setters>
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />
        </Style.Setters>
    </Style>
    <Style TargetType="TextBlock" BasedOn="{StaticResource ResourceKey=baseTextBlockStyle}">
        <Style.Setters>
            <Setter Property="Margin" Value="4,0,4,0" />
        </Style.Setters>
    </Style>
    <Style TargetType="GroupBox" x:Key="baseManualGroupBoxStyle">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ReadOnly, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
        </Style.Triggers>
        <Setter Property="Background" Value="DodgerBlue" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding Path=AllowDrop, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=GroupBox}}" Content="{Binding Header, RelativeSource={RelativeSource Mode=TemplatedParent}}">
                        <CheckBox.Template>
                            <ControlTemplate>
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{x:Null}" Background="DodgerBlue">
                                    <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border Style="{StaticResource ResourceKey=borderBaseStyle}" Background="DodgerBlue" HorizontalAlignment="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=HorizontalContentAlignment}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ContentControl Margin="3">
                                <ContentPresenter ContentSource="Header" />
                            </ContentControl>
                            <Grid Grid.Row="1" Background="White">
                                <ContentPresenter>
                                    <ContentPresenter.Style>
                                        <Style TargetType="ContentPresenter">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Path=AllowDrop, RelativeSource={RelativeSource Mode=TemplatedParent}}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentPresenter.Style>
                                </ContentPresenter>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <converter:BoolToVisibilityConverter x:Key="boolToVisibilityConverter" />
    <DataTemplate x:Key="onOffSensorTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Margin="4" VerticalAlignment="Center" Text="{Binding RelativeSource={RelativeSource AncestorType=ContentControl, Mode=FindAncestor}, Path=Tag}" />
            <CheckBox Name="checkBoxSensor" AllowDrop="{Binding IsOn}"
                      IsEnabled="True" Width="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight, Mode=OneWay}"
                      Focusable="False">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Style.Triggers>
                            <Trigger Property="AllowDrop" Value="True">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Label Background="Lime" Width="Auto" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="AllowDrop" Value="False">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Label Background="Gray" Width="Auto" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </CheckBox.Style>
            </CheckBox>
            <TextBlock Text="{Binding InputIO[0].Name}" VerticalAlignment="Center" Margin="4"
                       Visibility="{Binding Path=IsChecked, Mode=OneWay, ElementName=checkBoxSensor, Converter={StaticResource boolToVisibilityConverter}}" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="rightPositionOnOffSensorTemplate">
        <StackPanel Name="stackpanel" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <CheckBox Name="checkBoxSensor" AllowDrop="{Binding IsOn}"
                      IsEnabled="True" Width="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight, Mode=OneWay}"
                      Focusable="False">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Style.Triggers>
                                <Trigger Property="AllowDrop" Value="True">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Label Background="Lime" Width="Auto" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="AllowDrop" Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Label Background="Gray" Width="Auto" Height="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <TextBlock Name="ioName" Text="{Binding InputIO[0].Name}" VerticalAlignment="Center" Margin="4"
                       Visibility="{Binding Path=IsChecked, Mode=OneWay, ElementName=checkBoxSensor, Converter={StaticResource boolToVisibilityConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource baseTextBlockStyle}">
                            <Setter Property="Width" Value="0" />
                            <Setter Property="Height" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InputIO.Count}" Value="1">
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="Height" Value="Auto" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Margin="4" VerticalAlignment="Center"
                           Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContentControl}, Path=Tag}" />
            </StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource inputIOList}" Visibility="{Binding ElementName=ioName, Path=Visibility, Mode=OneWay}" />
        </StackPanel>        
    </DataTemplate>
    <Style TargetType="GroupBox" BasedOn="{StaticResource baseManualGroupBoxStyle}" />
    <DataTemplate x:Key="onOffPartOperationTemplate">
        <DockPanel HorizontalAlignment="Stretch">
            <Grid DockPanel.Dock="Top">
                <TextBlock Text="{Binding Path=Status.DisplayName}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2" />
            </Grid>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource inputIOList}" DockPanel.Dock="Top" />
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource outputIOList}" IsEnabled="{Binding Path=Debug, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1}}" DockPanel.Dock="Top" />
            <Button Command="{Binding Source={x:Static utility:StaticCommands.OnOffCommand}}" CommandParameter="{Binding RelativeSource={RelativeSource Self}, Path=Tag}"                                
                                DockPanel.Dock="Top" Height="40" MinWidth="150" Tag="{Binding}">
                <Button.Content>
                    <MultiBinding>
                        <MultiBinding.Converter>
                            <converter:OnOffPartAvailableStatusConverter />
                        </MultiBinding.Converter>
                        <Binding />
                        <Binding Path="Status" />
                    </MultiBinding>
                </Button.Content>
            </Button>
            <DockPanel LastChildFill="True">
                <CheckBox Style="{StaticResource ledCheckBox}" DockPanel.Dock="Left" MinWidth="50"
                                      Content="Repeat"
                                      Margin="2"
                                      Command="{Binding Source={x:Static utility:StaticCommands.OnOffRepeatCommand}}"                                      
                                      Tag="{Binding ElementName=textBoxRepeatTime, Path=Text}">
                    <CheckBox.CommandParameter>
                        <MultiBinding>
                            <MultiBinding.Converter>
                                <converter:MultiValueConverter />
                            </MultiBinding.Converter>
                            <Binding RelativeSource="{RelativeSource Self}" />
                            <Binding />
                            <Binding ElementName="textBoxRepeatTime" Path="Text" UpdateSourceTrigger="PropertyChanged" />
                        </MultiBinding>
                    </CheckBox.CommandParameter>
                </CheckBox>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Mode=TwoWay, ElementName=scrollBar, Path=Value, StringFormat='#0.0'}" Tag="{Binding Mode=OneTime, Path=Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=GroupBox}}" Name="textBoxRepeatTime" VerticalContentAlignment="Center" Margin="2">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Text" Value="{Binding Path=Tag, RelativeSource={RelativeSource Self}}" />
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="{x:Null}">
                                        <Setter Property="Text" Value="2" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Viewbox Grid.Column="1" Margin="1">
                        <ScrollBar Name="scrollBar" Value="2" Height="30" Width="20" Minimum="0" Maximum="100" SmallChange="0.1">
                            <ScrollBar.RenderTransform>
                                <RotateTransform Angle="180" CenterX="0.5" CenterY="0.5" />
                            </ScrollBar.RenderTransform>
                            <ScrollBar.RenderTransformOrigin>
                                <Point X="0.5" Y="0.5" />
                            </ScrollBar.RenderTransformOrigin>
                        </ScrollBar>
                    </Viewbox>
                    <TextBlock Text="sec" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,2,4,2" />
                </Grid>
            </DockPanel>
        </DockPanel>
    </DataTemplate>
    <Style x:Key="onOffPartOperation" TargetType="GroupBox" BasedOn="{StaticResource baseManualGroupBoxStyle}">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Header" Value="{Binding Path=Content.Name, RelativeSource={RelativeSource Self}, Converter={StaticResource CamelCaseConverter}, ConverterParameter=' '}" />
        <Setter Property="ContentTemplate" Value="{StaticResource onOffPartOperationTemplate}" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ResourceKey=baseStyle}">
        <Style.Setters>
            <Setter Property="Margin" Value="2" />
        </Style.Setters>
    </Style>
    <Style x:Key="oneWayMotorOperation" TargetType="GroupBox" BasedOn="{StaticResource baseManualGroupBoxStyle}">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Header" Value="{Binding Path=Content.Name, RelativeSource={RelativeSource Self}, Converter={StaticResource CamelCaseConverter}, ConverterParameter=' '}" />
        <Setter Property="ContentTemplate" Value="{StaticResource oneWayMotorTemplate}" />
    </Style>
    <Style x:Key="actuatorSelectButtonCanvas" TargetType="Canvas">
        <Style.Resources>
            <ResourceDictionary>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.8" />
                    <Setter Property="Command" Value="{Binding Source={x:Static utility:StaticCommands.ActuatorSelectCommand}}" />
                    <Setter Property="CommandParameter" Value="{Binding RelativeSource={RelativeSource Self}}" />
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <EventTrigger.Actions>
                                <BeginStoryboard x:Name="ButtonAction">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:3" AutoReverse="False"  RepeatBehavior="Forever" FillBehavior="HoldEnd" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <EventTrigger.Actions>
                                <BeginStoryboard >
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" FillBehavior="HoldEnd">
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger.Actions>
                            <!--<EventTrigger.Actions>
                                <StopStoryboard BeginStoryboardName="ButtonAction" />
                            </EventTrigger.Actions>-->
                        </EventTrigger>
                        <Trigger Property="DataContext" Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding>
                                    <MultiBinding.Converter>
                                        <converter:IsEqualMultiValueConverter />
                                    </MultiBinding.Converter>
                                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                                    <Binding Path="Parent.Tag" RelativeSource="{RelativeSource Self}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Border Background="Yellow" CornerRadius="8">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Grid.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.8" Duration="0:0:1" RepeatBehavior="Forever" AutoReverse="True" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ResourceDictionary>
        </Style.Resources>
    </Style>
    <DataTemplate x:Key="servoMotorOperationTemplate">
        <StackPanel>
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource servoStatus}" />
            <StackPanel Tag="{Binding}">
                <ComboBox Name="positions"
                                      Height="30"
                                      ItemsSource="{Binding Converter={StaticResource ExtractServoPositionsConverter}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, Converter={StaticResource CamelCaseConverter}, ConverterParameter=' '}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Move to Pos"
                        Margin="2"
                        Command="{Binding Source={x:Static utility:StaticCommands.ServoMovePosCommand}}">
                    <Button.CommandParameter>
                        <MultiBinding>
                            <MultiBinding.Converter>
                                <converter:MultiValueConverter />
                            </MultiBinding.Converter>
                            <Binding />
                            <Binding Path="SelectedItem" ElementName="positions" />
                        </MultiBinding>
                    </Button.CommandParameter>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource baseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=positions, Path=SelectedItem}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource servoDefaultControl}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
    <Style x:Key="servoMotorOperation" TargetType="GroupBox" BasedOn="{StaticResource baseManualGroupBoxStyle}">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Header" Value="{Binding Path=Content.Name, RelativeSource={RelativeSource Self}, Converter={StaticResource CamelCaseConverter}, ConverterParameter=' '}" />
        <Setter Property="ContentTemplate" Value="{StaticResource servoMotorOperationTemplate}" />
    </Style>
    <Style x:Key="doorOperationTemplate" TargetType="GroupBox" BasedOn="{StaticResource baseManualGroupBoxStyle}">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Header" Value="{Binding Path=Content.Name, RelativeSource={RelativeSource Self}, Converter={StaticResource CamelCaseConverter}, ConverterParameter=' '}" />
        <Setter Property="ContentTemplate" Value="{StaticResource doorTemplate}" />
    </Style>
    <Style x:Key="operateButtonsItemsControlStyle" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <GroupBox Content="{Binding}">
                        <GroupBox.Style>
                            <Style TargetType="GroupBox" BasedOn="{StaticResource baseManualGroupBoxStyle}">
                                <Setter Property="Margin" Value="2" />
                                <Setter Property="Header" Value="{Binding Path=Content.Name, RelativeSource={RelativeSource Self}, Converter={StaticResource CamelCaseConverter}, ConverterParameter=' '}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mode=OneWay, Converter={StaticResource IsAssignableConverter}, ConverterParameter='FALibrary:FALibrary.Part.MemoryBasePart.FAPartMemoryBaseGeneric'}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource onOffPartOperationTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode=OneWay, Converter={StaticResource IsAssignableConverter}, ConverterParameter='FALibrary:FALibrary.Part.MemoryBasePart.FAPartOneWayACMotor'}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource oneWayMotorTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode=OneWay, Converter={StaticResource IsAssignableConverter}, ConverterParameter='FALibrary:FALibrary.Part.MemoryBasePart.FAPartTwoWayACMotor/ManualJogMode=False'}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource twoWayMotorTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode=OneWay, Converter={StaticResource IsAssignableConverter}, ConverterParameter='FALibrary:FALibrary.Part.MemoryBasePart.FAPartTwoWayACMotor/ManualJogMode=True'}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource twoWayMotorJogMoveTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode=OneWay, Converter={StaticResource IsAssignableConverter}, ConverterParameter='FALibrary:FALibrary.Part.MMCPart.FAMMCPart'}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource servoMotorOperationTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode=OneWay, Converter={StaticResource IsAssignableConverter}, ConverterParameter='FALibrary:FALibrary.Part.MemoryBasePart.FAPartDoor'}" Value="True">
                                        <Setter Property="ContentTemplate" Value="{StaticResource doorTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </GroupBox.Style>
                    </GroupBox>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="actuatorOperateButtons">
        <StackPanel Name="stackPanel">
            <StackPanel.Tag>
                <MultiBinding>
                    <MultiBinding.Converter>
                        <converter:TagToPartsConverter />
                    </MultiBinding.Converter>
                    <Binding />
                    <Binding RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=UserControl}" />
                </MultiBinding>
            </StackPanel.Tag>
            <Grid Name="parentControl" Visibility="Collapsed" DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
            <Grid Name="hidenGrid" Visibility="Collapsed" Tag="{Binding Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContentControl}, Mode=OneWay}" />
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox Name="viewAllParts"
                              Height="30"
                              Width="30"
                              VerticalAlignment="Center"
                              Style="{StaticResource InverseVisibleHidden}"/>
                    <!--<TextBlock Text=" View All Parts" VerticalAlignment="Center" />-->
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <ItemsControl
                              ItemsSource="{Binding Path=Tag, ElementName=stackPanel, Mode=OneWay}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl" BasedOn="{StaticResource operateButtonsItemsControlStyle}">
                                <Setter Property="Height" Value="650" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsChecked, ElementName=viewAllParts}" Value="False">
                                        <Setter Property="Height" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>
                    <ItemsControl
                              ItemsSource="{Binding Tag, RelativeSource={RelativeSource Self}, Mode=OneWay}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl" BasedOn="{StaticResource operateButtonsItemsControlStyle}">
                                <Setter Property="Height" Value="650" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=IsChecked, ElementName=viewAllParts}" Value="True">
                                        <Setter Property="Height" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.Tag>
                            <MultiBinding Converter="{StaticResource PartSearchConverter}">
                                <Binding Path="Tag" ElementName="hidenGrid" />
                                <Binding Path="Tag" ElementName="stackPanel" />
                                <Binding Path="DataContext" ElementName="parentControl" />
                            </MultiBinding>
                        </ItemsControl.Tag>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>
    <Style x:Key="sensorsCanvas" TargetType="Canvas">
        <Style.Resources>
            <Style TargetType="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Border Style="{StaticResource borderBaseStyle}" Margin="2" HorizontalAlignment="Stretch">
                                <ContentControl Content="{Binding}"
                                                Tag="{Binding Name, Converter={StaticResource CamelCaseConverter}, ConverterParameter=' '}"
                                                ContentTemplate="{StaticResource rightPositionOnOffSensorTemplate}" />
                            </Border>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>
    <Style x:Key="parametersCanvas" TargetType="Canvas">
        <Style.Resources>
            <Style TargetType="ContentPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Border Style="{StaticResource borderBaseStyle}" Margin="2" HorizontalAlignment="Stretch">
                                <ContentControl Content="{Binding}"
                                                Tag="{Binding Name, Converter={StaticResource CamelCaseConverter}, ConverterParameter=' '}"
                                                ContentTemplate="{StaticResource onOffSensorTemplate}" />
                            </Border>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
    </Style>
</ResourceDictionary>