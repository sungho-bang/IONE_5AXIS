            <Style x:Key="DateTimeInputTemplate" TargetType="Label">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource ResourceKey=Date}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="2" />
                                <DatePicker SelectedDate="{Binding Path=Date}" Grid.Row="0" Grid.Column="1" Margin="2" VerticalContentAlignment="Center" CalendarStyle="{StaticResource styleCalendar}" />
                                <TextBlock Text="{DynamicResource ResourceKey=Time}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="2" />
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="2" VerticalContentAlignment="Center">
                                        <TextBox.Text>
                                            <Binding Path="Hour" StringFormat="D2" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <utility:NumberRangeRule NumberType="sys:Int32"  Min="0" Max="24"/>
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                    <TextBox Grid.Column="1" Margin="2" VerticalContentAlignment="Center">
                                        <TextBox.Text>
                                            <Binding Path="Minute" StringFormat="D2" UpdateSourceTrigger="PropertyChanged">
                                                <Binding.ValidationRules>
                                                    <utility:NumberRangeRule NumberType="sys:Int32"  Min="0" Max="59"/>
                                                </Binding.ValidationRules>
                                            </Binding>
                                        </TextBox.Text>
                                    </TextBox>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

