            <Style x:Key="SequenceButton" TargetType="{x:Type Button}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Grid>
                                <Image x:Name="Sequence" Source="Images/Sequence.png" Stretch="UniformToFill" />
