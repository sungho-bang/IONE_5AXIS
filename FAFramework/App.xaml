                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Path=Name}" />
                            </GridView.Columns>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DataTemplate>
            <DataTemplate x:Key="outputIOList">
                <ListView ItemsSource="{Binding Path=OutputIO}" BorderBrush="{x:Null}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource hideHeaderStyle}">
                            <GridView.Columns>
                                <GridViewColumn Header="Value">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox Width="20" Height="20" IsChecked="{Binding Path=Value}" Style="{StaticResource LEDCheckBoxStyle}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Path=Name}" />
                            </GridView.Columns>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DataTemplate>
            <DataTemplate x:Key="onOffPartList">
                <ListView ItemsSource="{Binding}" BorderBrush="{x:Null}">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource hideHeaderStyle}">
                            <GridView.Columns>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Path=Name}" />
                                <GridViewColumn Header="State" DisplayMemberBinding="{Binding Path=Status}" />
                                <GridViewColumn Header="Value">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding Source={x:Static utility:StaticCommands.OnOffCommand}}"
                                                    CommandParameter="{Binding}"
                                                    Tag="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ResourceKey=baseStyle}">
                                                        <Setter Property="Margin" Value="2" />
                                                        <Setter Property="Content" Value="없음" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag.Status.Name}" Value="On">
                                                                <Setter Property="Content" Value="끄기" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag.Status.Name}" Value="Off">
                                                                <Setter Property="Content" Value="켜기" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView.Columns>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DataTemplate>
            <DataTemplate x:Key="servoStatus">
                <StackPanel>
                    <StackPanel.Resources>
                        <ResourceDictionary>
                            <Style TargetType="Label" BasedOn="{StaticResource ResourceKey=OnOffSensorLabel}">
                                <Style.Setters>
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="VerticalAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="2" />
                                </Style.Setters>
                            </Style>
                            <Style TargetType="TextBlock">
                                <Style.Setters>
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style.Setters>
                            </Style>
                        </ResourceDictionary>
                    </StackPanel.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="켜기" IsEnabled="{Binding Path=ServoOn}" />
                        <Label Grid.Row="0" Grid.Column="1" Content="비상" IsEnabled="{Binding Path=Emergency}" />
                        <Label Grid.Row="0" Grid.Column="2" Content="알람" IsEnabled="{Binding Path=ServoAlarm}" />
                        <Label Grid.Row="1" Grid.Column="0" Content="동작중" IsEnabled="{Binding Path=RunFlag}" />
                        <Label Grid.Row="1" Grid.Column="1" Content="+제한" IsEnabled="{Binding Path=PositiveLimit}" />
                        <Label Grid.Row="1" Grid.Column="2" Content="-제한" IsEnabled="{Binding Path=NegativeLimit}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition MinWidth="80" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="실제 위치" />
                        <DockPanel Grid.Row="0" Grid.Column="1" FlowDirection="RightToLeft" >
                            <TextBlock Text="mm" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Path=ActualPos}" HorizontalAlignment="Left" />
                        </DockPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="지령 위치" />
                        <DockPanel Grid.Row="1" Grid.Column="1" FlowDirection="RightToLeft" >
                            <TextBlock DockPanel.Dock="Left" Text="mm" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Path=CommandPos}" HorizontalAlignment="Left" />
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="servoDefaultControl">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="조그 속도" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text=" " />
                        <TextBox Grid.Column="2" Text="{Binding JogMoveSpeed, UpdateSourceTrigger=PropertyChanged}" />
                        <ScrollBar Grid.Column="3" Value="{Binding JogMoveSpeed}" Minimum="0" Maximum="100" Orientation="Horizontal" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Jog +">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseDown">
                                    <i:InvokeCommandAction Command="{Binding Source={x:Static utility:StaticCommands.PartActionExecuteCommand}}"
                                                           CommandParameter="{Binding Path=MoveJogPositive}"/>
                                </i:EventTrigger>
                                <i:EventTrigger EventName="PreviewMouseUp">
                                    <i:InvokeCommandAction Command="{Binding Source={x:Static utility:StaticCommands.PartActionExecuteCommand}}"
                                                           CommandParameter="{Binding Path=Stop}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                        <Button Grid.Column="1" Content="Jog -">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseDown">
                                    <i:InvokeCommandAction Command="{Binding Source={x:Static utility:StaticCommands.PartActionExecuteCommand}}"
                                                           CommandParameter="{Binding Path=MoveJogNegative}"/>
                                </i:EventTrigger>
                                <i:EventTrigger EventName="PreviewMouseUp">
                                    <i:InvokeCommandAction Command="{Binding Source={x:Static utility:StaticCommands.PartActionExecuteCommand}}"
                                                           CommandParameter="{Binding Path=Stop}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="켜기"                        
                            Command="{Binding Source={x:Static utility:StaticCommands.PartActionExecuteCommand}}"
                            CommandParameter="{Binding Path=ServoOnAction}"/>
                        <Button Grid.Column="1" Content="끄기"
                            Command="{Binding Source={x:Static utility:StaticCommands.PartActionExecuteCommand}}"
                            CommandParameter="{Binding Path=ServoOffAction}"/>
                    </Grid>
                    <Button Content="알람 리셋"                        
                        Command="{Binding Source={x:Static utility:StaticCommands.PartActionExecuteCommand}}"
                        CommandParameter="{Binding Path=AlarmResetAction}"/>
                    <Button Content="정지"                        
                        Command="{Binding Source={x:Static utility:StaticCommands.PartActionExecuteCommand}}"
                        CommandParameter="{Binding Path=Stop}"/>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="sequenceTemplate">
                <StackPanel>
                    <StackPanel.Resources>
                        <ResourceDictionary>
                            <Style x:Key="buttonBaseStyle" TargetType="Button">
                                <Setter Property="Margin" Value="2" />
                                <Setter Property="MinHeight" Value="30" />
                            </Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ResourceKey=buttonBaseStyle}" />
                        </ResourceDictionary>
                    </StackPanel.Resources>
                    <TextBlock Text="{Binding Path=State}" Width="Auto" Height="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" />
                    <Button Content="시작"
                            Command="{Binding Source={x:Static utility:StaticCommands.SequenceExecuteCommand}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ResourceKey=buttonBaseStyle}">
                                <Setter Property="IsEnabled" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=State}" Value="Available">
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=State}" Value="Terminated">
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=State}" Value="Aborted">
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Resume"
                            Command="{Binding Source={x:Static utility:StaticCommands.SequenceResumeCommand}}"
                            CommandParameter="{Binding}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ResourceKey=buttonBaseStyle}">
                                <Setter Property="IsEnabled" Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=State}" Value="Suspended">
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Stop"
                            Command="{Binding Source={x:Static utility:StaticCommands.SequenceStopCommand}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </DataTemplate>
            <Style x:Key="borderBaseStyle" TargetType="Border" x:Shared="False">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderThickness" Value="3" />
                <Setter Property="BorderBrush" Value="DodgerBlue" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="2" />
            </Style>
            <Style x:Key="borderBaseStyle1" TargetType="Border" x:Shared="False">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="DarkOrange" />
                <Setter Property="BorderThickness" Value="3" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="2" />
            </Style>
            <Style x:Key="manualControl" TargetType="UserControl">
                <Setter Property="Width" Value="1024" />
                <Setter Property="Height" Value="768" />
                <Setter Property="FontFamily" Value="Tahoma" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ReadOnly}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="oneWayMotorTemplate">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Height="30" HorizontalAlignment="Center" Text="{Binding Path=Status}" VerticalAlignment="Center" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource inputIOList}" DockPanel.Dock="Top" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="시작" Command="{Binding Source={x:Static utility:StaticCommands.OneWayMotorRunCommand}}" CommandParameter="{Binding}" Height="40" />
                        <Button Grid.Column="1" Content="정지" Command="{Binding Source={x:Static utility:StaticCommands.OneWayMotorStopCommand}}" CommandParameter="{Binding}" Height="40" />
                    </Grid>
                </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="twoWayMotorTemplate">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Height="30" HorizontalAlignment="Center" Text="{Binding Path=Status}" VerticalAlignment="Center" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource inputIOList}" DockPanel.Dock="Top" />
                    <UniformGrid DockPanel.Dock="Top" Rows="1">
                        <Button Content="{Binding RunAction.ActionName}" Command="{Binding Source={x:Static utility:StaticCommands.TwoWayMotorRunCommand}}" CommandParameter="{Binding}" Height="40" />
                        <Button Content="{Binding ReverseRunAction.ActionName}" Command="{Binding Source={x:Static utility:StaticCommands.TwoWayMotorReserveRunCommand}}" CommandParameter="{Binding}" Height="40" />
                        <Button Content="{Binding StopAction.ActionName}" Command="{Binding Source={x:Static utility:StaticCommands.TwoWayMotorStopCommand}}" CommandParameter="{Binding}" Height="40" />
                    </UniformGrid>
                </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="twoWayMotorJogMoveTemplate">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Height="30" HorizontalAlignment="Center" Text="{Binding Path=Status}" VerticalAlignment="Center" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource inputIOList}" DockPanel.Dock="Top" />
                    <UniformGrid DockPanel.Dock="Top" Rows="1">
                        <Button Content="{Binding RunAction.ActionName}" Height="40">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseDown">
                                    <i:InvokeCommandAction Command="{Binding Source={x:Static utility:StaticCommands.PartActionExecuteCommand}}"
                                                           CommandParameter="{Binding Path=RunAction}"/>
                                </i:EventTrigger>
                                <i:EventTrigger EventName="PreviewMouseUp">
                                    <i:InvokeCommandAction Command="{Binding Source={x:Static utility:StaticCommands.PartActionExecuteCommand}}"
                                                           CommandParameter="{Binding Path=StopAction}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                        <Button Content="{Binding ReverseRunAction.ActionName}" Height="40">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseDown">
                                    <i:InvokeCommandAction Command="{Binding Source={x:Static utility:StaticCommands.PartActionExecuteCommand}}"
                                                           CommandParameter="{Binding Path=ReverseRunAction}"/>
                                </i:EventTrigger>
                                <i:EventTrigger EventName="PreviewMouseUp">
                                    <i:InvokeCommandAction Command="{Binding Source={x:Static utility:StaticCommands.PartActionExecuteCommand}}"
                                                           CommandParameter="{Binding Path=StopAction}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </UniformGrid>
                </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="doorTemplate">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource baseTextBlockStyle}">
                                <Setter Property="Text" Value="{DynamicResource Opened}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=Closed}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource Closed}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Top" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource baseTextBlockStyle}">
                                <Setter Property="Text" Value="{DynamicResource Unknown}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Locked}" Value="Lock">
                                        <Setter Property="Text" Value="{DynamicResource Lock}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Locked}" Value="Unlock">
                                        <Setter Property="Text" Value="{DynamicResource Unlock}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource inputIOList}" DockPanel.Dock="Top" />
                    <UniformGrid DockPanel.Dock="Top" Rows="1">
                        <Button Content="{DynamicResource Lock}" Command="{Binding Source={x:Static utility:StaticCommands.DoorLockCommand}}" CommandParameter="{Binding}" Height="40" />
                        <Button Content="{DynamicResource Unlock}" Command="{Binding Source={x:Static utility:StaticCommands.DoorUnlockCommand}}" CommandParameter="{Binding}" Height="40" />
                    </UniformGrid>
                </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="spinner">
                <Grid Width="5" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="75"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="White" />
                    <Border Grid.Row="1" CornerRadius="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Gray" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </DataTemplate>
            <Style TargetType="ContentControl">
                <Setter Property="RenderTransformOrigin" Value="0.5 0.5" />
            </Style>
            <converter:IntIsSameToBoolConverter x:Key="intIsSameToBoolConverter" />
            <DataTemplate x:Key="spinnerTemplate">
                <Grid>
                    <ProgressBar Name="animationTrigger" Visibility="Collapsed" Minimum="0" Maximum="16">
                        <ProgressBar.Triggers>
                            <EventTrigger RoutedEvent="ProgressBar.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Value" From="0" To="16" Duration="0:0:1.2" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ProgressBar.Triggers>
                    </ProgressBar>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=1}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="0" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=2}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="24" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=3}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="48" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=4}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="72" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=5}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="96" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=6}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="120" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=7}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="144" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=8}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="168" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=9}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="192" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=10}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="216" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=11}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="240" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=12}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="264" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=13}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="288" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=14}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="312" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                    <ContentControl ContentTemplate="{StaticResource spinner}" Content="{Binding ElementName=animationTrigger, Path=Value, Converter={StaticResource intIsSameToBoolConverter}, ConverterParameter=15}">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="336" />
                        </ContentControl.RenderTransform>
                    </ContentControl>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="IOTemplate">
                <Border Background="White" Style="{StaticResource borderBaseStyle}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding Value}" Width="{Binding RelativeSource={RelativeSource Self}, Path=ActualHeight}" Style="{StaticResource LEDCheckBoxStyle}" IsEnabled="False" />
                        <TextBlock Text=" " />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DataTemplate>
            <ControlTemplate x:Key="HourTemplate" TargetType="TextBox">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Name="textBox" Text="{Binding Value, ElementName=scrollBar}" VerticalContentAlignment="Center" IsHitTestVisible="False" />
                    <Viewbox Grid.Column="1" Margin="1">
                        <ScrollBar Name="scrollBar" Value="{Binding Text, RelativeSource={RelativeSource Mode=TemplatedParent}}" Height="30" Width="20" Minimum="0" Maximum="23" SmallChange="1">
                            <ScrollBar.RenderTransform>
                                <RotateTransform Angle="180" CenterX="0.5" CenterY="0.5" />
                            </ScrollBar.RenderTransform>
                            <ScrollBar.RenderTransformOrigin>
                                <Point X="0.5" Y="0.5" />
                            </ScrollBar.RenderTransformOrigin>
                        </ScrollBar>
                    </Viewbox>
                </Grid>
            </ControlTemplate>
            <ControlTemplate x:Key="MinuteTemplate" TargetType="TextBox">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Name="textBox" Text="{Binding Value, ElementName=scrollBar}" VerticalContentAlignment="Center" IsHitTestVisible="False" />
                    <Viewbox Grid.Column="1" Margin="1">
                        <ScrollBar Name="scrollBar" Value="{Binding Text, RelativeSource={RelativeSource Mode=TemplatedParent}}" Height="30" Width="20" Minimum="0" Maximum="59" SmallChange="1">
                            <ScrollBar.RenderTransform>
                                <RotateTransform Angle="180" CenterX="0.5" CenterY="0.5" />
                            </ScrollBar.RenderTransform>
                            <ScrollBar.RenderTransformOrigin>
                                <Point X="0.5" Y="0.5" />
                            </ScrollBar.RenderTransformOrigin>
                        </ScrollBar>
                    </Viewbox>
                </Grid>
            </ControlTemplate>
            <DrawingBrush x:Key="WireDrawingBrushKey"
            Viewport="0 0 10 10"
            ViewportUnits="Absolute"
            TileMode="Tile">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <DrawingGroup.Children>
                            <GeometryDrawing Geometry="M 0 0 L 1 0 1 0.1 0 0.1 Z" Brush="#66ccccff" />
                            <GeometryDrawing Geometry="M 0 0 L 0 1 0.1 1 0.1 0 Z" Brush="#66ccccff" />
                        </DrawingGroup.Children>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <Style x:Key="FlatButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
