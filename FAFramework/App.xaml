                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" TargetName="Sequence" Value="0"/>
                                    <Setter Property="Opacity" TargetName="Sequence1" Value="0.5" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
