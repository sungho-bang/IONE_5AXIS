# Normalize text files.
* text=auto

# Visual Studio / C# source and project files.
*.cs text diff=csharp
*.xaml text
*.xml text
*.config text
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text
*.targets text
*.txt text
*.md text
*.json text
*.resx text

# Large or binary build artifacts.
*.exe filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
